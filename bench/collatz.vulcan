fn steps(n: i64) -> i64 {
    let c = 0
    let m = n
    while m != 1 {
        if m % 2 == 0 {
            m /= 2
        }
        else {
            m = 3 * m + 1
        }
        c++
    }
    return c
}
fn main() -> void {
    let total = 0
    for i in 1 .. 1000000 {
        total += steps(i)
    }
    print("collatz total:", total)
}
