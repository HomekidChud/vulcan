fn is_prime(n: i64) -> bool {
    if n < 2 { return false }
    let i = 2
    while i * i <= n {
        if n % i == 0 { return false }
        i++
    }
    return true
}
fn main() -> void {
    let count = 0
    for n in 2 .. 1000000 {
        if is_prime(n) { count++ }
    }
    print("primes:", count)
}
