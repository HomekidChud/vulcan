// lib/engine.vulcan — the Vulcan Engine v0.5
//
// A game-engine layer in pure Vulcan, built on the existing stack:
//   import render3d  (Vec3 / Camera / projection / draw_tri pipeline)
//   canvas builtins  (draw_rect / draw_line / draw_text / present)
//   nested arrays    ([[f64]] heightmap terrain — added in Vulcan 1.4)
//
// This is NOT a port or clone of Epic's Unreal Engine (that is a
// multi-million-line proprietary product). This is vulcan's own engine,
// grown system by system. See TODO.md for the roadmap.
//
// Conventions:
//   - +Y is up (matches render3d)
//   - terrain is a heightmap grid: heights[r][c], cell size = terrain_scale
//   - fixed timestep simulation, render every frame
//   - entities are value structs in a flat array (spawn returns the new id)

import render3d

// ---------------------------------------------------------------------------
// Entities
// ---------------------------------------------------------------------------

pub struct Entity {
    id: i64,
    active: bool,
    name: string,
    kind: i64,          // game-defined: 0 player, 1 bot, 2 projectile, ...
    pos: Vec3,
    vel: Vec3,
    radius: f64,
    hp: f64,
    max_hp: f64,
    speed: f64,
    alive: bool,
    ai_state: i64,      // AI_IDLE / AI_WANDER / AI_CHASE / AI_ATTACK
    ai_timer: f64,      // seconds until the bot re-decides
    target_id: i64,     // what this entity is chasing / who fired it
    damage: f64,        // projectile impact damage
    lifetime: f64,      // projectile seconds-to-live
}

pub const ENTITY_KIND_PLAYER: i64 = 0
pub const ENTITY_KIND_BOT: i64 = 1
pub const ENTITY_KIND_PROJECTILE: i64 = 2
pub const ENTITY_KIND_PICKUP: i64 = 3

// AI states (Entity.ai_state)
pub const AI_IDLE: i64 = 0
pub const AI_WANDER: i64 = 1
pub const AI_CHASE: i64 = 2
pub const AI_ATTACK: i64 = 3

// ---------------------------------------------------------------------------
// Scene / world
// ---------------------------------------------------------------------------

// A lightweight visual effect particle: flies with velocity, fades over
// its lifetime, drawn as a small shaded rectangle.
pub struct Particle {
    active: bool,
    pos: Vec3,
    vel: Vec3,
    life: f64,      // seconds remaining
    max_life: f64,  // life at spawn (for fading)
    color: i64,     // 0xRRGGBB
}

pub struct Scene {
    entities: [Entity],
    particles: [Particle],
    next_id: i64,
    camera: Camera,
    time: f64,              // simulated seconds
    gravity: f64,           // units/s^2, negative = down
    terrain: [[f64]],       // heightmap grid
    terrain_scale: f64,     // world units per grid cell
    terrain_size: f64,      // world extent (terrain.len() * scale)
}

pub fn scene_new() -> Scene {
    let ents: [Entity] = []
    let terr: [[f64]] = []
    let parts: [Particle] = []
    return Scene {
        entities: ents,
        particles: parts,
        next_id: 1,
        camera: Camera { x: 0.0, y: 10.0, z: 0.0, yaw: 0.0, pitch: 0.0 },
        time: 0.0,
        gravity: -30.0,
        terrain: terr,
        terrain_scale: 4.0,
        terrain_size: 0.0,
    }
}

// Flat terrain of n x n cells at the given height.
pub fn scene_flat_terrain(s: Scene, n: i64, height: f64) -> Scene {
    let rows: [[f64]] = []
    for r in 0 .. n {
        let row: [f64] = []
        for c in 0 .. n {
            row.push(height)
        }
        rows.push(row)
    }
    s.terrain = rows
    s.terrain_size = (n as f64) * s.terrain_scale
    return s
}

// Spawn an entity (copy-in/copy-out: re-assign the scene, like the physics
// engine — `s = scene_spawn(s, ...)`, then `scene_last_id(s)` is the new id).
pub fn scene_spawn(s: Scene, name: string, kind: i64, pos: Vec3) -> Scene {
    let id = s.next_id
    s.next_id = id + 1
    // `pos` is already a per-call copy: the compiler clones struct arguments
    // on every backend (value semantics), so no manual defensive copy here
    let p = pos
    s.entities.push(Entity {
        id: id,
        active: true,
        name: name,
        kind: kind,
        pos: p,
        vel: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
        radius: 0.5,
        hp: 100.0,
        max_hp: 100.0,
        speed: 8.0,
        alive: true,
        ai_state: AI_IDLE,
        ai_timer: 0.0,
        target_id: -1,
        damage: 0.0,
        lifetime: 0.0,
    })
    return s
}

// The id of the most recently spawned entity.
// Spawn a pickup entity (kind ENTITY_KIND_PICKUP): an inert, damage-free
// entity games can use for health packs, ammo, loot, etc.
pub fn scene_spawn_pickup(s: Scene, name: string, pos: Vec3) -> Scene {
    let id = s.next_id
    s.next_id = id + 1
    let p = pos // per-call copy (value semantics)
    s.entities.push(Entity {
        id: id,
        active: true,
        name: name,
        kind: ENTITY_KIND_PICKUP,
        pos: p,
        vel: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
        radius: 0.4,
        hp: 1.0,
        max_hp: 1.0,
        speed: 0.0,
        alive: true,
        ai_state: AI_IDLE,
        ai_timer: 0.0,
        target_id: -1,
        damage: 0.0,
        lifetime: 0.0,
    })
    return s
}

pub fn scene_last_id(s: Scene) -> i64 {
    return s.next_id - 1
}

// Find an entity index by id (-1 if not found).
pub fn scene_find(s: Scene, id: i64) -> i64 {
    for i in 0 .. s.entities.len() {
        if s.entities[i].id == id {
            return i
        }
    }
    return -1
}

// Deactivate entities whose hp dropped to 0 (call each frame).
pub fn scene_reap(s: Scene) -> Scene {
    for i in 0 .. s.entities.len() {
        if s.entities[i].alive && s.entities[i].hp <= 0.0 {
            s.entities[i].alive = false
            s.entities[i].active = false
        }
    }
    return s
}

pub fn scene_count_alive(s: Scene, kind: i64) -> i64 {
    let n = 0
    for i in 0 .. s.entities.len() {
        if s.entities[i].active && s.entities[i].kind == kind {
            n += 1
        }
    }
    return n
}

// ---------------------------------------------------------------------------
// Terrain
// ---------------------------------------------------------------------------

// World height at (x, z); outside the grid returns 0.
pub fn terrain_height(s: Scene, x: f64, z: f64) -> f64 {
    if s.terrain.len() == 0 { return 0.0 }
    let n = s.terrain.len()
    let c = (x / s.terrain_scale + (n as f64) / 2.0) as i64
    let r = (z / s.terrain_scale + (n as f64) / 2.0) as i64
    if r < 0 || r >= n { return 0.0 }
    let row: [f64] = s.terrain[r]
    if c < 0 || c >= row.len() { return 0.0 }
    return row[c]
}

// ---------------------------------------------------------------------------
// Simulation
// ---------------------------------------------------------------------------

// One fixed-timestep tick: gravity, ground collision, friction.
pub fn scene_step(s: Scene, dt: f64) -> Scene {
    for i in 0 .. s.entities.len() {
        let e = s.entities[i]
        if !e.active { continue }
        // projectiles are fully owned by scene_step_projectiles
        // (their own motion + swept impact test) — don't double-integrate
        if e.kind == ENTITY_KIND_PROJECTILE { continue }
        // gravity
        e.vel.y = e.vel.y + s.gravity * dt
        // integrate
        e.pos.x = e.pos.x + e.vel.x * dt
        e.pos.y = e.pos.y + e.vel.y * dt
        e.pos.z = e.pos.z + e.vel.z * dt
        // ground collision: rest on the terrain, kill downward velocity
        let ground = terrain_height(s, e.pos.x, e.pos.z) + e.radius
        if e.pos.y < ground {
            e.pos.y = ground
            if e.vel.y < 0.0 { e.vel.y = 0.0 }
            // ground friction on the horizontal plane
            e.vel.x = e.vel.x * 0.85
            e.vel.z = e.vel.z * 0.85
        }
        // write the (possibly mutated) entity back — the C backend is
        // value-semantics, so `e` is a copy until we store it again
        s.entities[i] = e
    }
    s = scene_step_projectiles(s, dt)
    s = scene_step_particles(s, dt)
    s.time = s.time + dt
    return s
}

// ---------------------------------------------------------------------------
// Player controller (third-person style)
// ---------------------------------------------------------------------------

// NOTE: key codes are the LOWERCASE character codes ('w' = 119), because
// every input path (web keydown, IDE, native terminal bytes) delivers
// lowercase characters. Uppercase (shift-held) input is normalized to
// lowercase before it reaches the game.
pub const KEY_W: i64 = 119
pub const KEY_A: i64 = 97
pub const KEY_S: i64 = 115
pub const KEY_D: i64 = 100
pub const KEY_F: i64 = 102
pub const KEY_R: i64 = 114
pub const KEY_SPACE: i64 = 32
pub const KEY_ARROW_LEFT: i64 = 37
pub const KEY_ARROW_RIGHT: i64 = 39

// Move an entity from WASD input relative to the camera yaw; SPACE jumps
// when grounded. Returns the updated scene.
pub fn player_control(s: Scene, id: i64, dt: f64) -> Scene {
    let i = scene_find(s, id)
    if i < 0 { return s }
    let e = s.entities[i]
    let fwd = cam_forward(s.camera)
    let right = cam_right(s.camera)
    let move_x = 0.0
    let move_z = 0.0
    if key_down(KEY_W) { move_x = move_x + fwd.x; move_z = move_z + fwd.z }
    if key_down(KEY_S) { move_x = move_x - fwd.x; move_z = move_z - fwd.z }
    if key_down(KEY_D) { move_x = move_x + right.x; move_z = move_z + right.z }
    if key_down(KEY_A) { move_x = move_x - right.x; move_z = move_z - right.z }
    let len = sqrt(move_x * move_x + move_z * move_z)
    if len > 0.0 {
        e.vel.x = move_x / len * e.speed
        e.vel.z = move_z / len * e.speed
    } else {
        e.vel.x = 0.0
        e.vel.z = 0.0
    }
    let ground = terrain_height(s, e.pos.x, e.pos.z) + e.radius
    if key_down(KEY_SPACE) && e.pos.y <= ground + 0.01 {
        e.vel.y = 12.0
    }
    // write the controlled entity back (value semantics on the C backend)
    s.entities[i] = e
    // third-person chase camera
    let back = fwd.scaled(-6.0)
    let up = Vec3 { x: 0.0, y: 3.0, z: 0.0 }
    let p = e.pos
    let target = p.add(back)
    target = target.add(up)
    s.camera.x = lerp(s.camera.x, target.x, clamp(dt * 8.0, 0.0, 1.0))
    s.camera.y = lerp(s.camera.y, target.y, clamp(dt * 8.0, 0.0, 1.0))
    s.camera.z = lerp(s.camera.z, target.z, clamp(dt * 8.0, 0.0, 1.0))
    return s
}

// Camera-relative WASD movement + jump for first-person games. Unlike
// player_control, this never moves the camera — set s.camera yourself
// (e.g. cam_first_person + mouse look) and call this for movement.
pub fn player_move_cam(s: Scene, id: i64, dt: f64) -> Scene {
    let i = scene_find(s, id)
    if i < 0 { return s }
    let e = s.entities[i]
    let fwd = cam_forward(s.camera)
    let right = cam_right(s.camera)
    let move_x = 0.0
    let move_z = 0.0
    if key_down(KEY_W) { move_x = move_x + fwd.x; move_z = move_z + fwd.z }
    if key_down(KEY_S) { move_x = move_x - fwd.x; move_z = move_z - fwd.z }
    if key_down(KEY_D) { move_x = move_x + right.x; move_z = move_z + right.z }
    if key_down(KEY_A) { move_x = move_x - right.x; move_z = move_z - right.z }
    let len = sqrt(move_x * move_x + move_z * move_z)
    if len > 0.0 {
        e.vel.x = move_x / len * e.speed
        e.vel.z = move_z / len * e.speed
    } else {
        e.vel.x = 0.0
        e.vel.z = 0.0
    }
    let ground = terrain_height(s, e.pos.x, e.pos.z) + e.radius
    if key_down(KEY_SPACE) && e.pos.y <= ground + 0.01 {
        e.vel.y = 12.0
    }
    s.entities[i] = e
    return s
}

// ---------------------------------------------------------------------------
// HUD helpers (canvas)
// ---------------------------------------------------------------------------

pub fn hud_health_bar(x: i64, y: i64, w: i64, hp: f64, max_hp: f64) -> void {
    let frac = clamp(hp / max_hp, 0.0, 1.0)
    draw_rect(x, y, w, 3, 0x202020)
    let filled = ((w as f64) * frac) as i64
    if filled > 0 {
        let color = 0x00ff00
        if frac < 0.6 { color = 0xffff00 }
        if frac < 0.3 { color = 0xff0000 }
        draw_rect(x, y, filled, 3, color)
    }
}

pub fn hud_crosshair(cx: i64, cy: i64) -> void {
    draw_line(cx - 4, cy, cx + 4, cy, 0xffffff)
    draw_line(cx, cy - 4, cx, cy + 4, 0xffffff)
}

// Top-down minimap: dots for entities inside `range` around the camera.
pub fn hud_minimap(s: Scene, x: i64, y: i64, size: i64, range: f64) -> void {
    draw_rect(x, y, size, size, 0x101820)
    let half = (size as f64) / 2.0
    for i in 0 .. s.entities.len() {
        let e = s.entities[i]
        if !e.active { continue }
        let dx = e.pos.x - s.camera.x
        let dz = e.pos.z - s.camera.z
        if abs(dx) > range || abs(dz) > range { continue }
        let mx = x + (half + dx / range * half) as i64
        let my = y + (half + dz / range * half) as i64
        let color = 0x00ff00
        if e.kind == ENTITY_KIND_BOT { color = 0xff4040 }
        if e.kind == ENTITY_KIND_PICKUP { color = 0xffd700 }
        draw_rect(mx, my, 1, 1, color)
    }
}

// Heading compass strip: N/E/S/W ticks slide with the camera yaw.
pub fn hud_compass(yaw: f64, x: i64, y: i64, w: i64) -> void {
    draw_rect(x, y, w, 7, 0x101820)
    let dirs = ["N", "E", "S", "W"]
    let i = 0
    while i < 4 {
        // angle of this direction relative to the camera heading
        let a = (i as f64) * 1.5707963 - yaw
        // wrap to -pi..pi
        while a > 3.14159265 { a = a - 6.2831853 }
        while a < -3.14159265 { a = a + 6.2831853 }
        // 90-degree fov -> half the strip is visible
        if abs(a) < 1.6 {
            let px = x + (w as f64 / 2.0 + a / 1.6 * (w as f64 / 2.0 - 4.0)) as i64
            if px >= x + 1 && px <= x + w - 3 {
                draw_text(px, y + 1, dirs[i], 0xE8EDF2)
            }
        }
        i = i + 1
    }
}

// ---------------------------------------------------------------------------
// Raycasts (hitscan shooting, line of sight)
// ---------------------------------------------------------------------------

// Ray vs sphere. `dir` must be normalized. Returns hit distance t, or -1.
pub fn ray_sphere(origin: Vec3, dir: Vec3, center: Vec3, radius: f64) -> f64 {
    let oc = center.sub(origin)
    let tca = oc.dot(dir)
    if tca < 0.0 { return -1.0 }
    let d2 = oc.dot(oc) - tca * tca
    let r2 = radius * radius
    if d2 > r2 { return -1.0 }
    let thc = sqrt(r2 - d2)
    let t = tca - thc
    if t < 0.0 { return tca + thc }
    return t
}

// Ray vs axis-aligned box (slab method). Returns entry distance, or -1.
pub fn ray_aabb(origin: Vec3, dir: Vec3, bmin: Vec3, bmax: Vec3) -> f64 {
    let tmin = -999999.0
    let tmax = 999999.0
    let lo = bmin.sub(origin)
    let hi = bmax.sub(origin)
    // x slab
    if abs(dir.x) < 0.000001 {
        if origin.x < bmin.x || origin.x > bmax.x { return -1.0 }
    } else {
        let t1 = lo.x / dir.x
        let t2 = hi.x / dir.x
        let near = min(t1, t2)
        let far = max(t1, t2)
        tmin = max(tmin, near)
        tmax = min(tmax, far)
        if tmin > tmax { return -1.0 }
    }
    // y slab
    if abs(dir.y) < 0.000001 {
        if origin.y < bmin.y || origin.y > bmax.y { return -1.0 }
    } else {
        let t1 = lo.y / dir.y
        let t2 = hi.y / dir.y
        let near = min(t1, t2)
        let far = max(t1, t2)
        tmin = max(tmin, near)
        tmax = min(tmax, far)
        if tmin > tmax { return -1.0 }
    }
    // z slab
    if abs(dir.z) < 0.000001 {
        if origin.z < bmin.z || origin.z > bmax.z { return -1.0 }
    } else {
        let t1 = lo.z / dir.z
        let t2 = hi.z / dir.z
        let near = min(t1, t2)
        let far = max(t1, t2)
        tmin = max(tmin, near)
        tmax = min(tmax, far)
        if tmin > tmax { return -1.0 }
    }
    if tmax < 0.0 { return -1.0 }
    return max(tmin, 0.0)
}

// Nearest entity hit by a ray (sphere test), or -1. Skips `skip_id`
// (pass the shooter's id so projectiles don't hit their owner).
pub fn scene_raycast(s: Scene, origin: Vec3, dir: Vec3, skip_id: i64) -> i64 {
    let best_t = 999999.0
    let best_id = -1
    for i in 0 .. s.entities.len() {
        let e = s.entities[i]
        if !e.active || e.id == skip_id { continue }
        if e.kind == ENTITY_KIND_PROJECTILE { continue }
        let t = ray_sphere(origin, dir, e.pos, e.radius)
        if t >= 0.0 && t < best_t {
            best_t = t
            best_id = e.id
        }
    }
    return best_id
}

// Hitscan shot: raycast, apply damage to whatever is hit within range.
pub fn scene_shoot(s: Scene, shooter_id: i64, origin: Vec3, dir: Vec3, range: f64, damage: f64) -> Scene {
    let hit = scene_raycast(s, origin, dir, shooter_id)
    if hit >= 0 {
        let i = scene_find(s, hit)
        if i >= 0 {
            let dist = ray_sphere(origin, dir, s.entities[i].pos, s.entities[i].radius)
            if dist >= 0.0 && dist <= range {
                s.entities[i].hp = s.entities[i].hp - damage
            }
        }
    }
    return s
}

// ---------------------------------------------------------------------------
// Projectiles
// ---------------------------------------------------------------------------

// Fire a projectile entity (travels straight, damages on impact, expires).
pub fn scene_fire_projectile(s: Scene, shooter_id: i64, origin: Vec3, dir: Vec3, speed: f64, damage: f64, lifetime: f64) -> Scene {
    let d = dir.normalized()
    let vel = d.scaled(speed)
    // `origin` is a per-call copy (value semantics) — no defensive copy needed
    s = scene_spawn(s, "bullet", ENTITY_KIND_PROJECTILE, origin)
    let i = s.entities.len() - 1
    s.entities[i].vel = vel
    s.entities[i].damage = damage
    s.entities[i].lifetime = lifetime
    s.entities[i].radius = 0.2
    s.entities[i].target_id = shooter_id
    return s
}

// Projectile simulation: travel, impact, expiry. Called from scene_step.
fn scene_step_projectiles(s: Scene, dt: f64) -> Scene {
    for i in 0 .. s.entities.len() {
        let p = s.entities[i]
        if !p.active || p.kind != ENTITY_KIND_PROJECTILE { continue }
        p.lifetime = p.lifetime - dt
        if p.lifetime <= 0.0 {
            p.active = false
            s.entities[i] = p
            continue
        }
        // travel: move first, then test the swept segment so fast
        // projectiles cannot tunnel through a target in one step
        let old_pos = p.pos
        p.pos = p.pos.add(p.vel.scaled(dt))
        // impact: sphere vs every non-projectile entity that isn't the shooter
        for j in 0 .. s.entities.len() {
            let e = s.entities[j]
            if !e.active || e.kind == ENTITY_KIND_PROJECTILE || e.id == p.target_id { continue }
            let rr = e.radius + p.radius
            let diff = e.pos.sub(p.pos)
            let hit = diff.dot(diff) <= rr * rr
            if !hit {
                // swept test: did the travel segment pass through the entity?
                let seg = p.pos.sub(old_pos)
                let len = seg.length()
                if len > 0.000001 {
                    let t = ray_sphere(old_pos, seg.scaled(1.0 / len), e.pos, rr)
                    if t >= 0.0 && t <= len {
                        hit = true
                    }
                }
            }
            if !hit {
                continue
            }
            e.hp = e.hp - p.damage
            p.active = false
            s.entities[j] = e
            break
        }
        s.entities[i] = p
    }
    return s
}

// ---------------------------------------------------------------------------
// Bot AI
// ---------------------------------------------------------------------------

// Aggro range / attack range for bots (tune per game).
pub const BOT_AGGRO_RANGE: f64 = 24.0
pub const BOT_ATTACK_RANGE: f64 = 12.0
pub const BOT_FIRE_COOLDOWN: f64 = 1.2

// One AI tick for every bot: pick a state, steer, shoot.
// Uses rand_int for wandering — seed deterministically if you need
// reproducible runs.
pub fn bot_think(s: Scene, dt: f64) -> Scene {
    for i in 0 .. s.entities.len() {
        let b = s.entities[i]
        if !b.active || b.kind != ENTITY_KIND_BOT { continue }
        b.ai_timer = b.ai_timer - dt
        // find nearest player
        let target_id = -1
        let target_dist = 999999.0
        for j in 0 .. s.entities.len() {
            let t = s.entities[j]
            if !t.active || t.kind != ENTITY_KIND_PLAYER { continue }
            let diff = t.pos.sub(b.pos)
            let d = diff.length()
            if d < target_dist {
                target_dist = d
                target_id = t.id
            }
        }
        if target_id >= 0 && target_dist <= BOT_AGGRO_RANGE {
            // engage
            b.target_id = target_id
            if target_dist <= BOT_ATTACK_RANGE {
                b.ai_state = AI_ATTACK
            } else {
                b.ai_state = AI_CHASE
            }
        } else if b.ai_state != AI_WANDER {
            b.ai_state = AI_WANDER
            b.ai_timer = 0.0
        }
        // act on the state
        if b.ai_state == AI_WANDER {
            if b.ai_timer <= 0.0 {
                // pick a new random heading every ~2s
                b.ai_timer = 2.0
                let ang = (rand_int(0, 359) as f64) * 0.0174533
                b.vel.x = cos(ang) * b.speed * 0.4
                b.vel.z = sin(ang) * b.speed * 0.4
            }
        } else {
            // chase / attack: steer toward the target with atan2
            let ti = scene_find(s, b.target_id)
            if ti >= 0 {
                let t = s.entities[ti]
                let diff = t.pos.sub(b.pos)
                let flat = Vec3 { x: diff.x, y: 0.0, z: diff.z }
                let d = flat.length()
                if d > 0.001 {
                    b.vel.x = flat.x / d * b.speed
                    b.vel.z = flat.z / d * b.speed
                }
                if b.ai_state == AI_ATTACK && b.ai_timer <= 0.0 {
                    b.ai_timer = BOT_FIRE_COOLDOWN
                    let dir = diff.normalized()
                    let muzzle = b.pos.add(dir.scaled(b.radius + 0.3))
                    s = scene_fire_projectile(s, b.id, muzzle, dir, 30.0, 10.0, 2.0)
                }
            }
        }
        s.entities[i] = b
    }
    return s
}

// ---------------------------------------------------------------------------
// Procedural terrain
// ---------------------------------------------------------------------------

// Sum-of-sines island heightmap: n x n grid, amp around sea level.
pub fn terrain_sines(s: Scene, n: i64, amp: f64) -> Scene {
    let rows: [[f64]] = []
    for r in 0 .. n {
        let row: [f64] = []
        for c in 0 .. n {
            let x = (c as f64) - (n as f64) / 2.0
            let z = (r as f64) - (n as f64) / 2.0
            let h = sin(x * 0.13) * cos(z * 0.11) * amp
                + sin(x * 0.05 + 1.3) * amp * 0.5
                + cos(z * 0.07 + 0.4) * amp * 0.5
            // island falloff: flatten toward the edges
            let dx = x / ((n as f64) / 2.0)
            let dz = z / ((n as f64) / 2.0)
            let fall = 1.0 - min(1.0, dx * dx + dz * dz)
            row.push(h * fall)
        }
        rows.push(row)
    }
    s.terrain = rows
    s.terrain_size = (n as f64) * s.terrain_scale
    return s
}

// Advance the simulation in fixed steps; returns the updated scene.
// Use like:  s = engine_tick(s, frame_dt, 1.0 / 60.0)
pub fn engine_tick(s: Scene, frame_dt: f64, fixed_dt: f64) -> Scene {
    let remaining = clamp(frame_dt, 0.0, 0.1)
    while remaining >= fixed_dt {
        s = scene_step(s, fixed_dt)
        remaining = remaining - fixed_dt
    }
    return s
}

// ---------------------------------------------------------------------------
// Particles (Engine v0.3)
// ---------------------------------------------------------------------------

// Spawn a particle (pos/vel are copied — no aliasing on JS/Py backends).
// The pool is capped; the oldest particle is dropped when full.
pub const MAX_PARTICLES: i64 = 256

pub fn scene_spawn_particle(s: Scene, pos: Vec3, vel: Vec3, life: f64, color: i64) -> Scene {
    if s.particles.len() >= MAX_PARTICLES {
        // recycle the first slot
        s.particles[0] = Particle {
            active: true,
            pos: pos, // struct literal fields are cloned (value semantics)
            vel: vel,
            life: life,
            max_life: life,
            color: color,
        }
        return s
    }
    s.particles.push(Particle {
        active: true,
        pos: pos, // struct literal fields are cloned (value semantics)
        vel: vel,
        life: life,
        max_life: life,
        color: color,
    })
    return s
}

// Move particles, apply a fraction of gravity, expire dead ones.
fn scene_step_particles(s: Scene, dt: f64) -> Scene {
    for i in 0 .. s.particles.len() {
        let p = s.particles[i]
        if !p.active { continue }
        p.life = p.life - dt
        if p.life <= 0.0 {
            p.active = false
            s.particles[i] = p
            continue
        }
        p.vel.y = p.vel.y + s.gravity * 0.3 * dt
        p.pos = p.pos.add(p.vel.scaled(dt))
        s.particles[i] = p
    }
    return s
}

// Draw live particles as fading 2x2 rectangles.
pub fn draw_particles(s: Scene) -> void {
    for i in 0 .. s.particles.len() {
        let p = s.particles[i]
        if !p.active { continue }
        let pr = project(s.camera, p.pos)
        if pr.visible != 1 { continue }
        let t = p.life / p.max_life
        if t < 0.0 { t = 0.0 }
        draw_rect(pr.sx - 1.0, pr.sy - 1.0, 2.0, 2.0, color_shade(p.color, 0.3 + 0.7 * t))
    }
}

// ---------------------------------------------------------------------------
// Camera modes (Engine v0.3)
// ---------------------------------------------------------------------------

// First-person: camera at the entity's eye height, looking where you aim.
pub fn cam_first_person(eye: Vec3, yaw: f64, pitch: f64) -> Camera {
    return Camera { x: eye.x, y: eye.y + 1.6, z: eye.z, yaw: yaw, pitch: pitch }
}

// Orbit: circle around a target point at angle (radians), distance, height.
pub fn cam_orbit(target: Vec3, angle: f64, dist: f64, height: f64) -> Camera {
    return Camera {
        x: target.x + cos(angle) * dist,
        y: target.y + height,
        z: target.z + sin(angle) * dist,
        yaw: angle + 3.14159265,
        pitch: -0.35,
    }
}

// Spectator: free-fly camera, same shape as first-person.
pub fn cam_spectator(pos: Vec3, yaw: f64, pitch: f64) -> Camera {
    return Camera { x: pos.x, y: pos.y, z: pos.z, yaw: yaw, pitch: pitch }
}

// Third-person: camera behind and above the target on a boom, looking AT
// the target (positive pitch = camera higher, angled down). The camera
// always centers on the target so it can never slide off-screen.
pub fn cam_third_person(target: Vec3, yaw: f64, dist: f64, pitch: f64) -> Camera {
    let cp = cos(pitch)
    // build the Camera directly (cam_first_person adds a +1.6 eye-height
    // offset that would push the target off-center here)
    return Camera {
        x: target.x - sin(yaw) * cp * dist,
        y: target.y + sin(pitch) * dist,
        z: target.z - cos(yaw) * cp * dist,
        yaw: yaw, pitch: -pitch,
    }
}

// ---------------------------------------------------------------------------
// Atmosphere & lighting (Engine v0.4)
// ---------------------------------------------------------------------------

// Day/night cycle over `time` (simulated seconds). A full cycle is 120s:
// sin phase 1 = noon, 0 = sunrise/sunset, -1 = midnight. Returns the sky
// gradient as [top_color, bottom_color] (0xRRGGBB), tinted orange at dawn
// and dusk, deep blue at night.
pub fn sky_colors(time: f64) -> [i64] {
    let ang = sin(time * 6.28318 / 120.0)
    let day = ang
    if day < 0.0 { day = 0.0 }
    // dusk tint peaks at sunrise/sunset (ang near 0)
    let dusk = 1.0 - ang * 4.0
    if ang < 0.0 { dusk = 1.0 + ang * 4.0 }
    if dusk < 0.0 { dusk = 0.0 }
    let top = color_lerp(0x070B16, 0x8ECAE6, day)
    let bot = color_lerp(0x101828, 0xCDEFFD, day)
    top = color_lerp(top, 0x4A3266, dusk * 0.7)
    bot = color_lerp(bot, 0xE8925C, dusk * 0.7)
    return [top, bot]
}

// Ambient sun light for a given time: 1.0 at noon, ~0.45 at dawn/dusk,
// 0.22 at midnight (moonlight). Multiply surface colors by this for
// global day/night lighting. Matches the sky_colors() cycle.
pub fn sun_light(time: f64) -> f64 {
    let day = sin(time * 6.28318 / 120.0) * 2.0 + 0.3
    if day < 0.0 { day = 0.0 }
    if day > 1.0 { day = 1.0 }
    return 0.22 + 0.78 * day
}

// Distance fog: blend `col` toward `fog_col` between 40 and 130 world
// units, capped at 85% (never fully hides close geometry).
pub fn fog_mix(col: i64, dist: f64, fog_col: i64) -> i64 {
    let t = (dist - 40.0) / 90.0
    if t < 0.0 { t = 0.0 }
    if t > 0.85 { t = 0.85 }
    return color_lerp(col, fog_col, t)
}

// Animated sea color: two blues oscillating over `time`, blended a little
// toward the sky for reflections.
pub fn sea_color(time: f64, sky_bot: i64) -> i64 {
    let p = 0.5 + 0.5 * sin(time * 1.7)
    let c = color_lerp(0x1D5E8A, 0x2F89BB, p)
    return color_lerp(c, sky_bot, 0.15)
}

// Vertical sky gradient (top color at the top of the screen, bottom color
// at the horizon line `horizon_y`). Cheap fake skybox.
pub fn draw_sky_gradient(top: i64, bot: i64, horizon_y: i64) -> void {
    let y = 0
    while y < 144 {
        let t = y as f64 / horizon_y as f64
        if t > 1.0 { t = 1.0 }
        draw_rect(0.0, y as f64, 256.0, 1.0, color_lerp(top, bot, t))
        y = y + 1
    }
}

// ---------------------------------------------------------------------------
// Meshes (Engine v0.3)
// ---------------------------------------------------------------------------

// A renderable mesh: vertex list + triangle faces (index triples),
// drawn flat-shaded with the software renderer (draw_tri).
pub struct Mesh {
    verts: [Vec3],
    faces: [[i64]],
    color: i64,
}

pub fn mesh_new(color: i64) -> Mesh {
    let vs: [Vec3] = []
    let fs: [[i64]] = []
    return Mesh { verts: vs, faces: fs, color: color }
}

pub fn mesh_vert(m: Mesh, v: Vec3) -> Mesh {
    m.verts.push(Vec3 { x: v.x, y: v.y, z: v.z })
    return m
}

pub fn mesh_face(m: Mesh, a: i64, b: i64, c: i64) -> Mesh {
    let f: [i64] = [a, b, c]
    m.faces.push(f)
    return m
}

// A cube mesh centered on the origin, half-extent `half` (12 triangles).
pub fn mesh_cube(half: f64, color: i64) -> Mesh {
    let m = mesh_new(color)
    // 8 corners
    m = mesh_vert(m, Vec3 { x: -half, y: -half, z: -half })
    m = mesh_vert(m, Vec3 { x:  half, y: -half, z: -half })
    m = mesh_vert(m, Vec3 { x:  half, y: -half, z:  half })
    m = mesh_vert(m, Vec3 { x: -half, y: -half, z:  half })
    m = mesh_vert(m, Vec3 { x: -half, y:  half, z: -half })
    m = mesh_vert(m, Vec3 { x:  half, y:  half, z: -half })
    m = mesh_vert(m, Vec3 { x:  half, y:  half, z:  half })
    m = mesh_vert(m, Vec3 { x: -half, y:  half, z:  half })
    // 6 faces, 2 triangles each (CCW seen from outside)
    m = mesh_face(m, 1, 2, 6); m = mesh_face(m, 1, 6, 5)  // +X
    m = mesh_face(m, 0, 4, 7); m = mesh_face(m, 0, 7, 3)  // -X
    m = mesh_face(m, 4, 5, 6); m = mesh_face(m, 4, 6, 7)  // +Y
    m = mesh_face(m, 0, 3, 2); m = mesh_face(m, 0, 2, 1)  // -Y
    m = mesh_face(m, 2, 3, 7); m = mesh_face(m, 2, 7, 6)  // +Z
    m = mesh_face(m, 0, 1, 5); m = mesh_face(m, 0, 5, 4)  // -Z
    return m
}

// Draw a mesh at `pos` rotated `yaw` radians around Y, flat-shaded by a
// fixed light direction. Skips triangles with any vertex behind the camera.
pub fn mesh_draw(m: Mesh, cam: Camera, pos: Vec3, yaw: f64) -> void {
    let light = Vec3 { x: 0.4, y: 1.0, z: 0.3 }.normalized()
    let cy = cos(yaw)
    let sy = sin(yaw)
    for f in 0 .. m.faces.len() {
        let face = m.faces[f]
        if face.len() < 3 { continue }
        let a = m.verts[face[0]]
        let b = m.verts[face[1]]
        let c = m.verts[face[2]]
        // rotate around Y then translate
        let ra = Vec3 { x: a.x * cy + a.z * sy, y: a.y, z: -a.x * sy + a.z * cy }.add(pos)
        let rb = Vec3 { x: b.x * cy + b.z * sy, y: b.y, z: -b.x * sy + b.z * cy }.add(pos)
        let rc = Vec3 { x: c.x * cy + c.z * sy, y: c.y, z: -c.x * sy + c.z * cy }.add(pos)
        // flat shading from the face normal
        let n = rb.sub(ra).cross(rc.sub(ra)).normalized()
        let lum = n.dot(light)
        if lum < 0.0 { lum = -lum }
        let col = color_shade(m.color, 0.35 + 0.65 * lum)
        let pa = project(cam, ra)
        let pb = project(cam, rb)
        let pc = project(cam, rc)
        if pa.visible + pb.visible + pc.visible == 3 {
            draw_tri(pa.sx, pa.sy, pa.depth, pb.sx, pb.sy, pb.depth, pc.sx, pc.sy, pc.depth, col)
        }
    }
}

// ---------------------------------------------------------------------------
// Weapons (Engine v0.3)
// ---------------------------------------------------------------------------

// A weapon: fire-rate gating, ammo magazine, reload timing. Works with
// scene_shoot (hitscan) or scene_fire_projectile (ballistic).
pub struct Weapon {
    name: string,
    damage: f64,
    fire_cooldown: f64,  // seconds between shots
    cooldown: f64,       // seconds until ready (0 = ready)
    hitscan: bool,       // true = scene_shoot, false = projectile
    range: f64,          // hitscan range / projectile lifetime hint
    mag_size: i64,
    ammo: i64,
    reload_time: f64,    // seconds a reload takes
    reloading: f64,      // seconds of reload left (0 = not reloading)
}

pub fn weapon_new(name: string, damage: f64, fire_cooldown: f64, hitscan: bool, range: f64, mag_size: i64, reload_time: f64) -> Weapon {
    return Weapon {
        name: name,
        damage: damage,
        fire_cooldown: fire_cooldown,
        cooldown: 0.0,
        hitscan: hitscan,
        range: range,
        mag_size: mag_size,
        ammo: mag_size,
        reload_time: reload_time,
        reloading: 0.0,
    }
}

// Advance timers. Call once per tick with the same dt as scene_step.
pub fn weapon_tick(w: Weapon, dt: f64) -> Weapon {
    if w.cooldown > 0.0 {
        w.cooldown = w.cooldown - dt
        if w.cooldown < 0.0 { w.cooldown = 0.0 }
    }
    if w.reloading > 0.0 {
        w.reloading = w.reloading - dt
        if w.reloading <= 0.0 {
            w.reloading = 0.0
            w.ammo = w.mag_size
        }
    }
    return w
}

pub fn weapon_can_fire(w: Weapon) -> bool {
    return w.cooldown <= 0.0 && w.reloading <= 0.0 && w.ammo > 0
}

// Consume a shot (ammo + cooldown). Check weapon_can_fire first.
pub fn weapon_fire(w: Weapon) -> Weapon {
    w.ammo = w.ammo - 1
    w.cooldown = w.fire_cooldown
    return w
}

// Start a reload (only useful if ammo < mag_size).
pub fn weapon_reload(w: Weapon) -> Weapon {
    if w.ammo < w.mag_size && w.reloading <= 0.0 {
        w.reloading = w.reload_time
    }
    return w
}

// ---------------------------------------------------------------------------
// Save / load (Engine v0.3)
// ---------------------------------------------------------------------------

// Serialize a Scene to a text file (scene_save) and read it back
// (scene_load). Floats are stored with 6 significant digits (%.6g), so a
// round-trip is lossy at the 7th digit — plenty for checkpoints and level
// files. Entity names must not contain spaces.

pub fn scene_save(s: Scene, path: string) -> void {
    let out = "VULCANSCENE1\n"
    out = out + "time " + to_string(s.time) + "\n"
    out = out + "gravity " + to_string(s.gravity) + "\n"
    out = out + "next_id " + to_string(s.next_id) + "\n"
    out = out + "terrain " + to_string(s.terrain.len()) + " " + to_string(s.terrain_scale) + "\n"
    for r in 0 .. s.terrain.len() {
        let row = s.terrain[r]
        for c in 0 .. row.len() {
            if c > 0 { out = out + " " }
            out = out + to_string(row[c])
        }
        out = out + "\n"
    }
    for i in 0 .. s.entities.len() {
        let e = s.entities[i]
        if !e.active { continue }
        out = out + "ent "
        out = out + to_string(e.id) + " " + to_string(e.kind) + " " + to_string(e.radius) + " "
        out = out + to_string(e.hp) + " " + to_string(e.max_hp) + " " + to_string(e.speed) + " "
        out = out + to_string(e.ai_state) + " " + to_string(e.target_id) + " "
        out = out + to_string(e.pos.x) + " " + to_string(e.pos.y) + " " + to_string(e.pos.z) + " "
        out = out + to_string(e.vel.x) + " " + to_string(e.vel.y) + " " + to_string(e.vel.z) + " "
        out = out + e.name + "\n"
    }
    file_write(path, out)
}

pub fn scene_load(path: string) -> Scene {
    let s = scene_new()
    let raw = file_read(path)
    let lines = raw.split("\n")
    let li = 0
    // header
    li = 1
    // time / gravity / next_id
    let toks = lines[li].split(" ")
    s.time = to_float(toks[1])
    li = li + 1
    toks = lines[li].split(" ")
    s.gravity = to_float(toks[1])
    li = li + 1
    toks = lines[li].split(" ")
    s.next_id = to_int(toks[1])
    li = li + 1
    // terrain
    toks = lines[li].split(" ")
    let n = to_int(toks[1])
    s.terrain_scale = to_float(toks[2])
    li = li + 1
    let rows: [[f64]] = []
    for r in 0 .. n {
        let row: [f64] = []
        let h = lines[li].split(" ")
        for c in 0 .. n {
            row.push(to_float(h[c]))
        }
        rows.push(row)
        li = li + 1
    }
    s.terrain = rows
    s.terrain_size = (n as f64) * s.terrain_scale
    // entities
    for k in li .. lines.len() {
        let line = lines[k]
        if line.len() < 4 { continue }
        if line.substring(0, 4) != "ent " { continue }
        let t = line.split(" ")
        if t.len() < 16 { continue }
        let e = Entity {
            id: to_int(t[1]),
            active: true,
            name: t[15],
            kind: to_int(t[2]),
            pos: Vec3 { x: to_float(t[9]), y: to_float(t[10]), z: to_float(t[11]) },
            vel: Vec3 { x: to_float(t[12]), y: to_float(t[13]), z: to_float(t[14]) },
            radius: to_float(t[3]),
            hp: to_float(t[4]),
            max_hp: to_float(t[5]),
            speed: to_float(t[6]),
            alive: true,
            ai_state: to_int(t[7]),
            ai_timer: 0.0,
            target_id: to_int(t[8]),
            damage: 0.0,
            lifetime: 0.0,
        }
        s.entities.push(e)
    }
    return s
}
