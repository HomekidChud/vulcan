// examples/liberty.vulcan — LIBERTY CITY, a GTA-style open-world driving game.
//
// A boxy city grid with two-tier buildings, sidewalks, street lights, trees,
// wandering pedestrians (full walk-cycle rigs) and drivable cars with
// grip/drift physics. Collect all 15 cash drops. Day/night cycle included.
//
// Controls:
//   W A S D      walk / drive (camera relative on foot)
//   mouse drag   look / turn the camera
//   E            enter / exit the nearest car
//   SPACE        handbrake (drift) while driving
//   R            restart after victory
//
// Mobile: the game draws its OWN touch controls (joystick + E button) via
// the touch_custom() API — raw touch points in canvas coords, no hardcoded
// UI. This file is the reference example for that freedom.
//
// Playable in the IDE, the web bundle (desktop + phone), and natively.

import engine

// ---- keys this game uses beyond the engine defaults ----
const KEY_E: i64 = 101

// ---- world layout constants ----
const BLOCK_PITCH: f64 = 30.0     // block center to block center
const BLOCK_HALF: f64 = 11.0      // sidewalk edge (block is 22 wide)
const PLOT_HALF: f64 = 9.0        // inner plot (buildings sit here)
const WORLD_EDGE: f64 = 73.0      // playfield clamp

// ---- a building footprint (axis-aligned box) ----
struct Building { x: f64, z: f64, hx: f64, hz: f64, h: f64, color: i64 }

// ---- a drivable car ----
struct Car { x: f64, z: f64, yaw: f64, speed: f64, vx: f64, vz: f64, color: i64 }

// ---- a wandering pedestrian ----
struct Ped { x: f64, z: f64, vx: f64, vz: f64, speed: f64, phase: f64, rig: Rig, down: f64 }

// ---- a cash drop ----
struct Cash { x: f64, z: f64, taken: bool }

// ---- helpers ----
fn clampf(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

// heading convention everywhere: forward = (sin yaw, 0, cos yaw)
fn fwd_x(yaw: f64) -> f64 { return sin(yaw) }
fn fwd_z(yaw: f64) -> f64 { return cos(yaw) }

// is a world point worth drawing? (distance + behind-camera cull)
fn vis(cam: Camera, x: f64, z: f64, maxd: f64) -> bool {
    let dx = x - cam.x
    let dz = z - cam.z
    if dx * dx + dz * dz > maxd * maxd { return false }
    let fw = cam_forward(cam)
    if dx * fw.x + dz * fw.z < -8.0 { return false }
    return true
}

// push a circle (px,pz,r) out of an axis-aligned rect; returns [px, pz, hit]
fn push_out(px: f64, pz: f64, r: f64, bx: f64, bz: f64, bhx: f64, bhz: f64) -> [f64] {
    let cx = clampf(px, bx - bhx, bx + bhx)
    let cz = clampf(pz, bz - bhz, bz + bhz)
    let dx = px - cx
    let dz = pz - cz
    let d2 = dx * dx + dz * dz
    if d2 >= r * r { return [px, pz, 0.0] }
    if d2 < 0.0001 {
        // dead center: push along the shortest axis
        let ox = bhx - (px - bx)
        let oz = bhz - (pz - bz)
        if ox < oz { return [bx + bhx + r, pz, 1.0] }
        return [px, bz + bhz + r, 1.0]
    }
    let d = sqrt(d2)
    let k = (r - d) / d
    return [px + dx * k, pz + dz * k, 1.0]
}

// ---- city generation (deterministic — same city every run) ----
fn city_buildings() -> [Building] {
    let b: [Building] = []
    let cols: [i64] = [0x8d9aa8, 0x9a8d7f, 0x7f8d9a, 0xa89d8d, 0x8d9a8d, 0x9d8d9a]
    let i = 0
    while i < 5 {
        let j = 0
        while j < 5 {
            let bx = (i - 2) as f64 * BLOCK_PITCH
            let bz = (j - 2) as f64 * BLOCK_PITCH
            let p = (i * 7 + j * 13) % 11
            // park blocks: no buildings, trees instead
            if p == 3 || p == 8 {
                j = j + 1
                continue
            }
            // 1-2 buildings per block, varying heights and colors
            let h1 = 4.0 + (p * 3) as f64
            b.push(Building { x: bx - 4.0, z: bz - 3.5, hx: 4.2, hz: 4.0, h: h1, color: cols[(i + j) % 6] })
            if p != 0 && p != 6 {
                let h2 = 6.0 + ((p * 5) % 12) as f64
                b.push(Building { x: bx + 4.5, z: bz + 4.0, hx: 3.6, hz: 3.4, h: h2, color: cols[(i + 2 * j) % 6] })
            }
            j = j + 1
        }
        i = i + 1
    }
    return b
}

// park block centers (for trees)
fn park_blocks() -> [Vec3] {
    let p: [Vec3] = []
    let i = 0
    while i < 5 {
        let j = 0
        while j < 5 {
            if (i * 7 + j * 13) % 11 == 3 || (i * 7 + j * 13) % 11 == 8 {
                p.push(Vec3 { x: (i - 2) as f64 * BLOCK_PITCH, y: 0.0, z: (j - 2) as f64 * BLOCK_PITCH })
            }
            j = j + 1
        }
        i = i + 1
    }
    return p
}

// street lights: one per block, alternating corners
fn street_lights() -> [Vec3] {
    let l: [Vec3] = []
    let i = 0
    while i < 5 {
        let j = 0
        while j < 5 {
            let bx = (i - 2) as f64 * BLOCK_PITCH
            let bz = (j - 2) as f64 * BLOCK_PITCH
            if (i + j) % 2 == 0 {
                l.push(Vec3 { x: bx - BLOCK_HALF, y: 0.0, z: bz - BLOCK_HALF })
            } else {
                l.push(Vec3 { x: bx + BLOCK_HALF, y: 0.0, z: bz + BLOCK_HALF })
            }
            j = j + 1
        }
        i = i + 1
    }
    return l
}

fn parked_cars() -> [Car] {
    let c: [Car] = []
    c.push(Car { x: -15.0, z: -28.0, yaw: 0.0, speed: 0.0, vx: 0.0, vz: 0.0, color: 0xc0392b })
    c.push(Car { x: 15.0, z: 28.0, yaw: 3.14159, speed: 0.0, vx: 0.0, vz: 0.0, color: 0x2965d8 })
    c.push(Car { x: -45.0, z: 12.0, yaw: 1.5708, speed: 0.0, vx: 0.0, vz: 0.0, color: 0x1fb6c9 })
    c.push(Car { x: 45.0, z: -45.0, yaw: 0.0, speed: 0.0, vx: 0.0, vz: 0.0, color: 0xc9a227 })
    return c
}

fn city_cash() -> [Cash] {
    let c: [Cash] = []
    let i = 0
    while i < 4 {
        let j = 0
        while j < 4 {
            // 16 intersections, drop one (15 total)
            if i == 3 && j == 3 { j = j + 1; continue }
            c.push(Cash { x: -45.0 + i as f64 * BLOCK_PITCH, z: -45.0 + j as f64 * BLOCK_PITCH, taken: false })
            j = j + 1
        }
        i = i + 1
    }
    return c
}

fn city_peds() -> [Ped] {
    let p: [Ped] = []
    let shirts: [i64] = [0x3a6ea5, 0xa53a4a, 0x3aa56a, 0xa58a3a, 0x6a3aa5, 0x35a5a5]
    let pants: [i64] = [0x2b2b3a, 0x3a3a3a, 0x4a3a2b, 0x24303a]
    let skins: [i64] = [0xd9a066, 0xc98d5a, 0x8a5a3a, 0xe8b88a]
    let hairs: [i64] = [0x1a1a1a, 0x3a2a1a, 0x5a4a2a, 0x777777]
    let i = 0
    while i < 14 {
        // walk along a block edge sidewalk line, across the whole city
        let line = ((i * 29) % 10 - 5) as f64 * BLOCK_PITCH * 0.5 + BLOCK_PITCH * 0.5
        // line lands near a road/sidewalk; snap to a block edge
        let edge = -60.0 + ((i * 17) % 5) as f64 * BLOCK_PITCH + BLOCK_HALF * 0.98
        if i % 2 == 0 {
            let rig = rig_new(shirts[i % 6], pants[i % 4], skins[i % 4], hairs[i % 4])
            p.push(Ped { x: -60.0 + i as f64 * 8.0, z: edge, vx: 1.0, vz: 0.0, speed: 1.3 + (i % 3) as f64 * 0.35, phase: i as f64 * 1.7, rig: rig, down: 0.0 })
        } else {
            let rig = rig_new(shirts[(i + 3) % 6], pants[(i + 1) % 4], skins[(i + 2) % 4], hairs[(i + 2) % 4])
            p.push(Ped { x: edge, z: -60.0 + i as f64 * 8.0, vx: 0.0, vz: 1.0, speed: 1.1 + (i % 4) as f64 * 0.3, phase: i as f64 * 2.1, rig: rig, down: 0.0 })
        }
        i = i + 1
    }
    return p
}

// ---- drawing helpers ----
fn draw_ground_plate(cam: Camera, cx: f64, cz: f64, hx: f64, hz: f64, y: f64, color: i64) -> void {
    draw_quad_clipped(cam,
        Vec3 { x: cx - hx, y: y, z: cz - hz },
        Vec3 { x: cx + hx, y: y, z: cz - hz },
        Vec3 { x: cx + hx, y: y, z: cz + hz },
        Vec3 { x: cx - hx, y: y, z: cz + hz },
        color)
}

fn draw_car_model(cam: Camera, c: Car, night: bool) -> void {
    let pos = Vec3 { x: c.x, y: 0.0, z: c.z }
    let fwd = Vec3 { x: fwd_x(c.yaw), y: 0.0, z: fwd_z(c.yaw) }
    // body + cabin
    mesh_draw_rot(mesh_box(0.95, 0.38, 2.1, c.color), cam, pos.add(Vec3 { x: 0.0, y: 0.56, z: 0.0 }), c.yaw, 0.0)
    mesh_draw_rot(mesh_box(0.80, 0.30, 1.0, 0x20242c), cam, pos.add(fwd.scaled(-0.35).add(Vec3 { x: 0.0, y: 1.18, z: 0.0 })), c.yaw, 0.0)
    // wheels
    let right = Vec3 { x: fwd_z(c.yaw), y: 0.0, z: -fwd_x(c.yaw) }
    let i = 0
    while i < 4 {
        let sx = 1.0
        if i % 2 == 0 { sx = -1.0 }
        let sz = 1.0
        if i < 2 { sz = -1.0 }
        let w = pos.add(right.scaled(sx * 0.85)).add(fwd.scaled(sz * 1.35)).add(Vec3 { x: 0.0, y: 0.28, z: 0.0 })
        mesh_draw_rot(mesh_box(0.16, 0.28, 0.34, 0x14161a), cam, w, c.yaw, 0.0)
        i = i + 1
    }
    // headlights (bright at night)
    let hcol = 0x555560
    if night { hcol = 0xFFE08A }
    mesh_draw_rot(mesh_box(0.22, 0.12, 0.06, hcol), cam, pos.add(right.scaled(-0.55)).add(fwd.scaled(2.1)).add(Vec3 { x: 0.0, y: 0.56, z: 0.0 }), c.yaw, 0.0)
    mesh_draw_rot(mesh_box(0.22, 0.12, 0.06, hcol), cam, pos.add(right.scaled(0.55)).add(fwd.scaled(2.1)).add(Vec3 { x: 0.0, y: 0.56, z: 0.0 }), c.yaw, 0.0)
    // tail lights
    mesh_draw_rot(mesh_box(0.2, 0.1, 0.05, 0x901818), cam, pos.add(right.scaled(-0.55)).add(fwd.scaled(-2.1)).add(Vec3 { x: 0.0, y: 0.56, z: 0.0 }), c.yaw, 0.0)
    mesh_draw_rot(mesh_box(0.2, 0.1, 0.05, 0x901818), cam, pos.add(right.scaled(0.55)).add(fwd.scaled(-2.1)).add(Vec3 { x: 0.0, y: 0.56, z: 0.0 }), c.yaw, 0.0)
}

// Near-plane-clipped quad (Sutherland-Hodgman) — same trick as frontier:
// the ground must fill the screen even when the camera straddles a quad edge.
fn draw_quad_clipped(cam: Camera, p0: Vec3, p1: Vec3, p2: Vec3, p3: Vec3, color: i64) -> void {
    let f = cam_forward(cam)
    let r = cam_right(cam)
    let u = f.cross(r)
    let xs: [f64] = []
    let ys: [f64] = []
    let zs: [f64] = []
    let pts: [Vec3] = [p0, p1, p2, p3]
    let i = 0
    while i < 4 {
        let d = Vec3 { x: pts[i].x - cam.x, y: pts[i].y - cam.y, z: pts[i].z - cam.z }
        xs.push(d.dot(r))
        ys.push(d.dot(u))
        zs.push(d.dot(f))
        i = i + 1
    }
    let cx: [f64] = []
    let cy: [f64] = []
    let cz: [f64] = []
    i = 0
    while i < 4 {
        let j = (i + 1) % 4
        let zi = zs[i]
        let zj = zs[j]
        if zi >= 0.5 {
            cx.push(xs[i]); cy.push(ys[i]); cz.push(zi)
        }
        if (zi >= 0.5 && zj < 0.5) || (zi < 0.5 && zj >= 0.5) {
            let t = (0.5 - zi) / (zj - zi)
            cx.push(xs[i] + (xs[j] - xs[i]) * t)
            cy.push(ys[i] + (ys[j] - ys[i]) * t)
            cz.push(0.5)
        }
        i = i + 1
    }
    let n = cx.len()
    if n < 3 { return }
    let sx: [f64] = []
    let sy: [f64] = []
    i = 0
    while i < n {
        sx.push(128.0 + cx[i] * 160.0 / cz[i])
        sy.push(72.0 - cy[i] * 160.0 / cz[i])
        i = i + 1
    }
    i = 1
    while i < n - 1 {
        draw_tri(sx[0], sy[0], cz[0], sx[i], sy[i], cz[i], sx[i + 1], sy[i + 1], cz[i + 1], color)
        i = i + 1
    }
}

// ---- the whole game, wrapped so R can restart cleanly ----
fn run_game() -> void {
    let buildings = city_buildings()
    let parks = park_blocks()
    let lights = street_lights()
    let cars = parked_cars()
    let cash = city_cash()
    let peds = city_peds()

    // player state
    let px = -15.0
    let pz = -20.0
    let pyaw = 0.0
    let pphase = 0.0
    let pmoving = 0.0
    let driving = -1        // index into cars, or -1 on foot
    let player_rig = rig_new(0x2e4a7a, 0x22262e, 0xd9a066, 0x1a1a1a)

    // game state
    let cam_yaw = 0.0
    let cam_pitch = 0.3
    let money = 0
    let collected = 0
    let elapsed = 0.0
    let wanted = 0.0
    let msg = ""
    let msg_timer = 0.0
    let victory = false
    let prev_e = false

    // touch UI state (we draw our own controls — touch_custom())
    let touch = is_touch()
    if touch { touch_custom() }

    let last_ms = ms_now()
    while true {
        let now = ms_now()
        let dt = (now - last_ms) as f64 / 1000.0
        last_ms = now
        if dt <= 0.0 { dt = 0.001 }
        if dt > 0.1 { dt = 0.1 }

        // --- look: mouse / touch drag ---
        let mdx = mouse_dx()
        let mdy = mouse_dy()
        cam_yaw = cam_yaw + mdx * 0.005
        cam_pitch = cam_pitch - mdy * 0.004
        cam_pitch = clampf(cam_pitch, -0.15, 0.85)

        // --- input: keyboard + our own touch UI ---
        let ix = 0.0
        let iy = 0.0
        if key_down(KEY_W) { iy = iy + 1.0 }
        if key_down(KEY_S) { iy = iy - 1.0 }
        if key_down(KEY_A) { ix = ix - 1.0 }
        if key_down(KEY_D) { ix = ix + 1.0 }
        let handbrake = key_down(KEY_SPACE)
        let e_press = false
        let r_press = false
        if key_ready() > 0 {
            let k = read_key()
            if k == KEY_E { e_press = true }
            if k == 114 { r_press = true }
        }
        // touch: joystick (bottom-left) + E button (bottom-right) + R (top-right)
        if touch {
            let ti = 0
            while ti < touch_count() {
                let tx = touch_x(ti)
                let ty = touch_y(ti)
                let jx = (tx - 38.0) / 16.0
                let jy = (ty - 118.0) / 16.0
                let jl = sqrt(jx * jx + jy * jy)
                if jl < 2.2 && tx < 90.0 && ty > 90.0 {
                    if jl > 1.0 {
                        ix = jx / jl
                        iy = -jy / jl
                    } else {
                        ix = jx
                        iy = -jy
                    }
                }
                let ex = tx - 228.0
                let ey = ty - 118.0
                if ex * ex + ey * ey < 144.0 { e_press = true }
                let rx = tx - 236.0
                let ry = ty - 92.0
                if rx * rx + ry * ry < 81.0 { r_press = true }
                ti = ti + 1
            }
        }
        if e_press && !prev_e {
            // enter / exit the nearest car
            if driving >= 0 {
                let c = cars[driving]
                let right = Vec3 { x: fwd_z(c.yaw), y: 0.0, z: -fwd_x(c.yaw) }
                px = c.x + right.x * 2.2
                pz = c.z + right.z * 2.2
                pyaw = c.yaw
                driving = -1
                msg = "ON FOOT"
                msg_timer = 1.2
            } else {
                let best = -1
                let bestd = 20.0
                let i = 0
                while i < cars.len() {
                    let dx = cars[i].x - px
                    let dz = cars[i].z - pz
                    let d2 = dx * dx + dz * dz
                    if d2 < bestd { bestd = d2; best = i }
                    i = i + 1
                }
                if best >= 0 {
                    driving = best
                    msg = "DRIVING — E TO EXIT, SPACE HANDBRAKE"
                    msg_timer = 2.0
                }
            }
        }
        prev_e = e_press
        if r_press && victory { return }

        // --- simulate ---
        elapsed = elapsed + dt
        if wanted > 0.0 { wanted = wanted - dt }

        if driving < 0 {
            // on foot: camera-relative movement
            let len = sqrt(ix * ix + iy * iy)
            if len > 0.05 {
                let mfx = sin(cam_yaw)
                let mfz = cos(cam_yaw)
                let mrx = cos(cam_yaw)
                let mrz = -sin(cam_yaw)
                let mx = (mfx * iy + mrx * ix) / len
                let mz = (mfz * iy + mrz * ix) / len
                px = px + mx * 5.5 * dt
                pz = pz + mz * 5.5 * dt
                pyaw = atan2(mx, mz)
                pphase = pphase + 10.0 * dt
                pmoving = pmoving + (1.0 - pmoving) * clampf(dt * 10.0, 0.0, 1.0)
            } else {
                pmoving = pmoving * (1.0 - clampf(dt * 8.0, 0.0, 1.0))
            }
            // collide with buildings and parked cars
            let i = 0
            while i < buildings.len() {
                let r = push_out(px, pz, 0.38, buildings[i].x, buildings[i].z, buildings[i].hx, buildings[i].hz)
                px = r[0]
                pz = r[1]
                i = i + 1
            }
            let i2 = 0
            while i2 < cars.len() {
                let r = push_out(px, pz, 0.55, cars[i2].x, cars[i2].z, 1.3, 1.3)
                px = r[0]
                pz = r[1]
                i2 = i2 + 1
            }
            px = clampf(px, -WORLD_EDGE, WORLD_EDGE)
            pz = clampf(pz, -WORLD_EDGE, WORLD_EDGE)
        } else {
            // driving: throttle / steer / grip physics
            let c = cars[driving]
            let throttle = iy
            let steer = ix
            if throttle > 0.0 { c.speed = c.speed + throttle * 9.0 * dt }
            if throttle < 0.0 {
                if c.speed > 0.5 { c.speed = c.speed + throttle * 16.0 * dt }
                else { c.speed = c.speed + throttle * 5.0 * dt }
            }
            if handbrake { c.speed = c.speed * (1.0 - 1.6 * dt) }
            c.speed = c.speed * (1.0 - 0.35 * dt)
            c.speed = clampf(c.speed, -8.0, 24.0)
            let sf = clampf(abs(c.speed) / 5.0, 0.0, 1.0)
            if c.speed < 0.0 { sf = -sf }
            c.yaw = c.yaw - steer * 1.9 * dt * sf
            // velocity chases the heading (low grip = drift on handbrake)
            let grip = 2.6
            if handbrake { grip = 0.45 }
            let tx = fwd_x(c.yaw) * c.speed
            let tz = fwd_z(c.yaw) * c.speed
            let k = clampf(grip * dt, 0.0, 1.0)
            c.vx = c.vx + (tx - c.vx) * k
            c.vz = c.vz + (tz - c.vz) * k
            c.x = c.x + c.vx * dt
            c.z = c.z + c.vz * dt
            // collide with buildings (dampen speed on impact)
            let i = 0
            while i < buildings.len() {
                let r = push_out(c.x, c.z, 1.45, buildings[i].x, buildings[i].z, buildings[i].hx, buildings[i].hz)
                if r[2] > 0.5 { c.speed = c.speed * 0.4 }
                c.x = r[0]
                c.z = r[1]
                i = i + 1
            }
            c.x = clampf(c.x, -WORLD_EDGE, WORLD_EDGE)
            c.z = clampf(c.z, -WORLD_EDGE, WORLD_EDGE)
            cars[driving] = c
            px = c.x
            pz = c.z
        }

        // pedestrians: wander, bounce at the city edge, get run over
        let i = 0
        while i < peds.len() {
            let p = peds[i]
            if p.down > 0.0 {
                p.down = p.down - dt
                peds[i] = p
                i = i + 1
                continue
            }
            p.x = p.x + p.vx * p.speed * dt
            p.z = p.z + p.vz * p.speed * dt
            p.phase = p.phase + 9.0 * dt
            if p.x > 70.0 { p.x = 70.0; p.vx = -1.0 }
            if p.x < -70.0 { p.x = -70.0; p.vx = 1.0 }
            if p.z > 70.0 { p.z = 70.0; p.vz = -1.0 }
            if p.z < -70.0 { p.z = -70.0; p.vz = 1.0 }
            // hit by the player's car?
            if driving >= 0 {
                let c = cars[driving]
                let dx = p.x - c.x
                let dz = p.z - c.z
                if dx * dx + dz * dz < 2.6 && abs(c.speed) > 6.0 {
                    p.down = 6.0
                    wanted = wanted + 20.0
                    if wanted > 60.0 { wanted = 60.0 }
                    msg = "HIT AND RUN — WANTED LEVEL UP"
                    msg_timer = 2.0
                }
            }
            peds[i] = p
            i = i + 1
        }

        // cash pickup (on foot or driving)
        let i = 0
        while i < cash.len() {
            if cash[i].taken { i = i + 1; continue }
            let dx = cash[i].x - px
            let dz = cash[i].z - pz
            if dx * dx + dz * dz < 2.6 {
                cash[i].taken = true
                money = money + 250
                collected = collected + 1
                msg = "$250"
                msg_timer = 1.0
                if collected >= cash.len() { victory = true }
            }
            i = i + 1
        }

        // --- camera ---
        let dist = 7.0
        let ty = 1.2
        if driving >= 0 { dist = 11.0; ty = 1.0 }
        let cam = cam_third_person(Vec3 { x: px, y: ty, z: pz }, cam_yaw, dist, cam_pitch)

        // --- render ---
        let day = 10.0 + elapsed * (120.0 / 120.0)
        let sky = sky_colors(day % 120.0)
        let sun = sun_light(day % 120.0)
        let night = sun < 0.35
        clear(sky[0])
        draw_sky_gradient(sky[0], sky[1], 96)

        // asphalt base plate + city blocks
        let ground_col = color_shade(0x3a3d44, 0.35 + 0.65 * sun)
        draw_ground_plate(cam, 0.0, 0.0, 78.0, 78.0, 0.0, ground_col)
        let sidewalk_col = color_shade(0x9a9aa2, 0.35 + 0.65 * sun)
        let plot_col = color_shade(0x6f7480, 0.35 + 0.65 * sun)
        let grass_col = color_shade(0x3d7a3a, 0.35 + 0.65 * sun)
        let bi = 0
        while bi < 5 {
            let bj = 0
            while bj < 5 {
                let bx = (bi - 2) as f64 * BLOCK_PITCH
                let bz = (bj - 2) as f64 * BLOCK_PITCH
                draw_ground_plate(cam, bx, bz, BLOCK_HALF, BLOCK_HALF, 0.06, sidewalk_col)
                let p = (bi * 7 + bj * 13) % 11
                if p == 3 || p == 8 {
                    draw_ground_plate(cam, bx, bz, PLOT_HALF, PLOT_HALF, 0.07, grass_col)
                } else {
                    draw_ground_plate(cam, bx, bz, PLOT_HALF, PLOT_HALF, 0.07, plot_col)
                }
                bj = bj + 1
            }
            bi = bi + 1
        }
        // lane dashes along the road centers
        let dash_col = color_shade(0xd8d8d0, 0.35 + 0.65 * sun)
        let ri = 0
        while ri < 4 {
            let rc = -45.0 + ri as f64 * BLOCK_PITCH
            let d = -72.0
            while d < 72.0 {
                if vis(cam, rc, d, 90.0) {
                    draw_ground_plate(cam, rc, d, 0.18, 1.6, 0.02, dash_col)
                }
                if vis(cam, d, rc, 90.0) {
                    draw_ground_plate(cam, d, rc, 1.6, 0.18, 0.02, dash_col)
                }
                d = d + 12.0
            }
            ri = ri + 1
        }

        // buildings (two tiers: base + upper setback)
        let i = 0
        while i < buildings.len() {
            let b = buildings[i]
            if !vis(cam, b.x, b.z, 110.0) { i = i + 1; continue }
            let shade = 0.3 + 0.7 * sun
            let col = color_shade(b.color, shade)
            mesh_draw_rot(mesh_box(b.hx, b.h * 0.5, b.hz, col), cam, Vec3 { x: b.x, y: b.h * 0.5, z: b.z }, 0.0, 0.0)
            // upper setback tier on tall buildings
            if b.h > 8.0 {
                mesh_draw_rot(mesh_box(b.hx * 0.72, (b.h - 8.0) * 0.5, b.hz * 0.72, color_shade(b.color, shade * 0.88)), cam, Vec3 { x: b.x, y: 8.0 + (b.h - 8.0) * 0.5, z: b.z }, 0.0, 0.0)
            }
            i = i + 1
        }

        // street lights (pole + head, glowing at night)
        let pole_col = color_shade(0x5a5f66, 0.4 + 0.6 * sun)
        let head_col = 0x777c84
        if night { head_col = 0xFFE08A }
        let i = 0
        while i < lights.len() {
            if !vis(cam, lights[i].x, lights[i].z, 95.0) { i = i + 1; continue }
            mesh_draw_rot(mesh_box(0.07, 2.2, 0.07, pole_col), cam, Vec3 { x: lights[i].x, y: 2.2, z: lights[i].z }, 0.0, 0.0)
            mesh_draw_rot(mesh_box(0.4, 0.1, 0.16, head_col), cam, Vec3 { x: lights[i].x, y: 4.35, z: lights[i].z }, 0.0, 0.0)
            i = i + 1
        }

        // park trees
        let trunk_col = color_shade(0x6b4a2f, 0.4 + 0.6 * sun)
        let crown_col = color_shade(0x2e6e2e, 0.35 + 0.65 * sun)
        let i = 0
        while i < parks.len() {
            let pk = parks[i]
            if !vis(cam, pk.x, pk.z, 95.0) { i = i + 1; continue }
            let t = 0
            while t < 4 {
                let tx = pk.x - 5.0 + (t % 2) as f64 * 10.0
                let tz = pk.z - 5.0 + (t / 2) as f64 * 10.0
                mesh_draw_rot(mesh_box(0.14, 0.9, 0.14, trunk_col), cam, Vec3 { x: tx, y: 0.9, z: tz }, 0.0, 0.0)
                mesh_draw_rot(mesh_box(1.0, 1.0, 1.0, crown_col), cam, Vec3 { x: tx, y: 2.3, z: tz }, 0.0, 0.0)
                t = t + 1
            }
            i = i + 1
        }

        // cash drops (spinning green cubes)
        let i = 0
        while i < cash.len() {
            if cash[i].taken { i = i + 1; continue }
            if !vis(cam, cash[i].x, cash[i].z, 80.0) { i = i + 1; continue }
            let bob = 0.7 + 0.2 * sin(elapsed * 3.0 + i as f64)
            mesh_draw(mesh_cube(0.32, 0x2ECC40), cam, Vec3 { x: cash[i].x, y: bob, z: cash[i].z }, elapsed * 2.0 + i as f64)
            i = i + 1
        }

        // cars
        let i = 0
        while i < cars.len() {
            if vis(cam, cars[i].x, cars[i].z, 110.0) {
                draw_car_model(cam, cars[i], night)
            }
            i = i + 1
        }

        // pedestrians
        let i = 0
        while i < peds.len() {
            let p = peds[i]
            if !vis(cam, p.x, p.z, 65.0) { i = i + 1; continue }
            if p.down > 0.0 {
                // knocked down: lying flat
                mesh_draw_rot(mesh_box(0.17, 0.30, 0.10, p.rig.shirt), cam, Vec3 { x: p.x, y: 0.3, z: p.z }, atan2(p.vx, p.vz), 1.5708)
            } else {
                rig_draw(p.rig, cam, Vec3 { x: p.x, y: 0.06, z: p.z }, atan2(p.vx, p.vz), p.phase, 1.0)
            }
            i = i + 1
        }

        // the player (on foot only — hidden while driving)
        if driving < 0 && !victory {
            rig_draw(player_rig, cam, Vec3 { x: px, y: 0.06, z: pz }, pyaw, pphase, pmoving)
        }

        // --- HUD ---
        draw_rect(0.0, 0.0, 92.0, 30.0, 0x101820)
        draw_text(4, 4, "LIBERTY CITY", 0xFFFFFF)
        draw_text(4, 12, "CASH $" + to_string(money), 0x66BB6A)
        draw_text(4, 20, "PICKED UP " + to_string(collected) + "/" + to_string(cash.len()), 0x9FB4C7)
        // minimap (north-up)
        draw_rect(200.0, 4.0, 52.0, 52.0, 0x101820)
        let i = 0
        while i < cash.len() {
            if !cash[i].taken {
                let mx = 202.0 + (cash[i].x + 75.0) / 150.0 * 48.0
                let mz = 6.0 + (cash[i].z + 75.0) / 150.0 * 48.0
                draw_rect(mx, mz, 2.0, 2.0, 0x2ECC40)
            }
            i = i + 1
        }
        let i = 0
        while i < cars.len() {
            let mx = 202.0 + (cars[i].x + 75.0) / 150.0 * 48.0
            let mz = 6.0 + (cars[i].z + 75.0) / 150.0 * 48.0
            draw_rect(mx, mz, 2.0, 2.0, 0xEF5350)
            i = i + 1
        }
        let pmx = 202.0 + (px + 75.0) / 150.0 * 48.0
        let pmz = 6.0 + (pz + 75.0) / 150.0 * 48.0
        draw_rect(pmx - 1.0, pmz - 1.0, 3.0, 3.0, 0xFFFFFF)
        // wanted stars
        if wanted > 0.0 {
            let stars = (wanted / 20.0) as i64 + 1
            if stars > 3 { stars = 3 }
            draw_text(202, 68, "WANTED " + to_string(stars), 0xEF5350)
        }
        // health + speed panels
        hud_health_bar(202, 58, 48, 100.0, 100.0)
        if driving >= 0 {
            let mph = (abs(cars[driving].speed) * 2.4) as i64
            draw_rect(196.0, 133.0, 58.0, 10.0, 0x101820)
            draw_text(200, 136, "SPD " + to_string(mph) + " MPH", 0xFFD54F)
        }
        // touch controls (drawn by the game itself)
        if touch {
            // joystick
            draw_circle(38.0, 118.0, 22.0, 0x2a2f3a)
            draw_circle(38.0, 118.0, 21.0, 0x40465a)
            let kx = 38.0 + clampf(ix, -1.0, 1.0) * 14.0
            let ky = 118.0 - clampf(iy, -1.0, 1.0) * 14.0
            if driving >= 0 { ky = 118.0 + clampf(iy, -1.0, 1.0) * 14.0 }
            draw_circle(kx, ky, 8.0, 0x9FB4C7)
            // E button
            draw_circle(228.0, 118.0, 12.0, 0x2a2f3a)
            draw_text(224, 116, "E", 0xFFFFFF)
            // R button (restart)
            draw_circle(236.0, 92.0, 9.0, 0x2a2f3a)
            draw_text(233, 90, "R", 0xFFFFFF)
        }
        // messages
        if msg_timer > 0.0 {
            msg_timer = msg_timer - dt
            draw_rect(128.0 - msg.len() as f64 * 2.0, 57.0, msg.len() as f64 * 4.0 + 8.0, 11.0, 0x101820)
            draw_text(132 - msg.len() as i64 * 2, 60, msg, 0xFFD54F)
        }
        if victory {
            draw_rect(48.0, 52.0, 160.0, 40.0, 0x101820)
            draw_text(92, 58, "ALL CASH COLLECTED", 0x66BB6A)
            draw_text(76, 70, "FINAL $" + to_string(money) + "  TIME " + to_string(elapsed as i64) + "s", 0xFFD54F)
            draw_text(88, 80, "PRESS R TO PLAY AGAIN", 0x9FB4C7)
        }

        present()
        sleep_ms(16)
    }
}

fn main() -> void {
    while true {
        run_game()
    }
}
