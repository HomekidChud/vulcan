// examples/fortnite.vulcan — FORT ISLAND: a Fortnite-style 3D battle royale.
//
// Built entirely on Vulcan's software 3D renderer (depth-buffered
// triangles + camera projection from lib/render3d.vulcan):
//   - procedural low-poly island with height-colored terrain
//   - third-person camera, WASD movement, mouse look, SPACE jump
//   - hitscan shooting (bots, walls, terrain), B to build walls
//   - bot opponents that wander, chase, shoot back and build
//   - shrinking storm circle with damage, chests, kill feed, HUD
//
// Play it in the IDE for real-time colors and input:
//   vulcan ide  ->  open examples/fortnite.vulcan  ->  Run
import render3d

// ---- world constants ----
const ISLAND: f64 = 256.0        // world spans 0..256 in x and z
const STORM_R0: f64 = 110.0      // initial storm radius
const MAX_WALLS: i64 = 48
const MAX_BOTS: i64 = 9
const MAX_CHESTS: i64 = 6
const FRAMES: i64 = 5400         // ~90s safety cap
const SKY: i64 = 0x9FD8F0

struct Bot { x: f64, z: f64, hp: i64, alive: i64, timer: i64, tx: f64, tz: f64, cd: i64, flash: i64, kills: i64 }
struct Wall { x: f64, z: f64, hp: i64, hit: i64 }
struct Chest { x: f64, z: f64, taken: i64 }

// ---- terrain: sum of sines with island falloff ----
fn terrain_h(x: f64, z: f64) -> f64 {
    let h = 4.0 * sin(x * 0.035 + 1.0) * cos(z * 0.04)
    h = h + 2.5 * sin(x * 0.09 + z * 0.06 + 3.0)
    h = h + 6.0 * cos(x * 0.015 + 2.0) * sin(z * 0.02 + 1.0)
    h = h + 10.0
    // island falloff toward the edges
    let dx = x - 128.0
    let dz = z - 128.0
    let d = sqrt(dx * dx + dz * dz)
    h = h - (d - 78.0) * 0.32
    if h < 0.0 { h = 0.0 }
    return h
}

fn terrain_color(h: f64) -> i64 {
    if h < 0.4 { return 0x2E7BC4 }         // shallow water
    if h < 1.6 { return 0xD8C98A }         // beach
    if h < 5.0 { return 0x4C9A3F }         // grass
    if h < 8.5 { return 0x39702F }         // dark grass
    return 0x8A8D90                       // rock
}

// ---- geometry helpers ----

// distance from ray origin to sphere, or -1
fn ray_sphere(ox: f64, oy: f64, oz: f64, dx: f64, dy: f64, dz: f64, cx: f64, cy: f64, cz: f64, r: f64) -> f64 {
    let ex = ox - cx
    let ey = oy - cy
    let ez = oz - cz
    let b = ex * dx + ey * dy + ez * dz
    let c = ex * ex + ey * ey + ez * ez - r * r
    let disc = b * b - c
    if disc < 0.0 { return -1.0 }
    let t = -b - sqrt(disc)
    if t < 0.0 { return -1.0 }
    return t
}

// distance from ray origin to axis-aligned box, or -1
fn ray_aabb(ox: f64, oy: f64, oz: f64, dx: f64, dy: f64, dz: f64, minx: f64, miny: f64, minz: f64, maxx: f64, maxy: f64, maxz: f64) -> f64 {
    let tmin = 0.0
    let tmax = 200.0
    // x slab
    if dx == 0.0 {
        if ox < minx { return -1.0 }
        if ox > maxx { return -1.0 }
    } else {
        let t1 = (minx - ox) / dx
        let t2 = (maxx - ox) / dx
        let lo = t1
        let hi = t2
        if t1 > t2 { lo = t2; hi = t1 }
        if lo > tmin { tmin = lo }
        if hi < tmax { tmax = hi }
        if tmin > tmax { return -1.0 }
    }
    // y slab
    if dy == 0.0 {
        if oy < miny { return -1.0 }
        if oy > maxy { return -1.0 }
    } else {
        let t1 = (miny - oy) / dy
        let t2 = (maxy - oy) / dy
        let lo = t1
        let hi = t2
        if t1 > t2 { lo = t2; hi = t1 }
        if lo > tmin { tmin = lo }
        if hi < tmax { tmax = hi }
        if tmin > tmax { return -1.0 }
    }
    // z slab
    if dz == 0.0 {
        if oz < minz { return -1.0 }
        if oz > maxz { return -1.0 }
    } else {
        let t1 = (minz - oz) / dz
        let t2 = (maxz - oz) / dz
        let lo = t1
        let hi = t2
        if t1 > t2 { lo = t2; hi = t1 }
        if lo > tmin { tmin = lo }
        if hi < tmax { tmax = hi }
        if tmin > tmax { return -1.0 }
    }
    return tmin
}

// wall footprint test with radius r (for movement blocking)
fn wall_blocks(walls: [Wall], x: f64, z: f64, r: f64) -> i64 {
    for w in walls {
        if w.hp > 0 {
            if abs(x - w.x) < 4.5 + r { 
                if abs(z - w.z) < 4.5 + r { return 1 }
            }
        }
    }
    return 0
}

// bot billboard: two stacked camera-facing quads (body + head)
fn draw_bot(cam: Camera, b: Bot) -> void {
    let gy = terrain_h(b.x, b.z)
    let r = cam_right(cam)
    let col = 0xB03030
    if b.flash > 0 { col = 0xFFFFFF }
    // body: from gy to gy+3.4, half-width 1.3
    let bx = b.x
    let bz = b.z
    draw_quad(cam,
        Vec3 { x: bx - r.x * 1.3, y: gy, z: bz - r.z * 1.3 },
        Vec3 { x: bx + r.x * 1.3, y: gy, z: bz + r.z * 1.3 },
        Vec3 { x: bx + r.x * 1.3, y: gy + 3.4, z: bz + r.z * 1.3 },
        Vec3 { x: bx - r.x * 1.3, y: gy + 3.4, z: bz - r.z * 1.3 },
        col)
    // head: gy+3.4 to gy+5, half-width 0.9
    draw_quad(cam,
        Vec3 { x: bx - r.x * 0.9, y: gy + 3.4, z: bz - r.z * 0.9 },
        Vec3 { x: bx + r.x * 0.9, y: gy + 3.4, z: bz + r.z * 0.9 },
        Vec3 { x: bx + r.x * 0.9, y: gy + 5.0, z: bz + r.z * 0.9 },
        Vec3 { x: bx - r.x * 0.9, y: gy + 5.0, z: bz - r.z * 0.9 },
        0xE8B88A)
}

// player billboard (green)
fn draw_player(cam: Camera, px: f64, pz: f64, py: f64) -> void {
    let r = cam_right(cam)
    draw_quad(cam,
        Vec3 { x: px - r.x * 1.2, y: py, z: pz - r.z * 1.2 },
        Vec3 { x: px + r.x * 1.2, y: py, z: pz + r.z * 1.2 },
        Vec3 { x: px + r.x * 1.2, y: py + 3.4, z: pz + r.z * 1.2 },
        Vec3 { x: px - r.x * 1.2, y: py + 3.4, z: pz - r.z * 1.2 },
        0x30A060)
    draw_quad(cam,
        Vec3 { x: px - r.x * 0.85, y: py + 3.4, z: pz - r.z * 0.85 },
        Vec3 { x: px + r.x * 0.85, y: py + 3.4, z: pz + r.z * 0.85 },
        Vec3 { x: px + r.x * 0.85, y: py + 5.0, z: pz + r.z * 0.85 },
        Vec3 { x: px - r.x * 0.85, y: py + 5.0, z: pz - r.z * 0.85 },
        0xE8B88A)
}

fn fog(color: i64, depth: f64) -> i64 {
    let t = (depth - 55.0) / 90.0
    if t < 0.0 { t = 0.0 }
    if t > 0.65 { t = 0.65 }
    return color_lerp(color, SKY, t)
}

fn main() -> void {
    // ---- player state ----
    let px = 128.0
    let pz = 60.0
    let py = terrain_h(px, pz)
    let vy = 0.0
    let yaw = 0.0
    let pitch = -0.15
    let hp = 100
    let kills = 0
    let shoot_cd = 0
    let build_cd = 0
    let grounded = 1

    // ---- arrays (pre-sized, set-only) ----
    let walls: [Wall] = []
    for i in 0 .. MAX_WALLS { walls.push(Wall { x: 0.0, z: 0.0, hp: 0, hit: 0 }) }
    let bots: [Bot] = []
    let bot_spots: [f64] = []
    bot_spots.push(70.0); bot_spots.push(180.0)
    bot_spots.push(200.0); bot_spots.push(120.0)
    bot_spots.push(90.0); bot_spots.push(60.0)
    bot_spots.push(170.0); bot_spots.push(200.0)
    bot_spots.push(40.0); bot_spots.push(150.0)
    bot_spots.push(210.0); bot_spots.push(80.0)
    bot_spots.push(120.0); bot_spots.push(220.0)
    bot_spots.push(60.0); bot_spots.push(100.0)
    bot_spots.push(150.0); bot_spots.push(40.0)
    for i in 0 .. MAX_BOTS {
        let bx = bot_spots[i * 2]
        let bz = bot_spots[i * 2 + 1]
        bots.push(Bot { x: bx, z: bz, hp: 100, alive: 1, timer: 0, tx: bx, tz: bz, cd: 0, flash: 0, kills: 0 })
    }
    let chests: [Chest] = []
    let chest_spots: [f64] = []
    chest_spots.push(100.0); chest_spots.push(100.0)
    chest_spots.push(160.0); chest_spots.push(140.0)
    chest_spots.push(80.0); chest_spots.push(170.0)
    chest_spots.push(190.0); chest_spots.push(90.0)
    chest_spots.push(120.0); chest_spots.push(50.0)
    chest_spots.push(140.0); chest_spots.push(200.0)
    for i in 0 .. MAX_CHESTS {
        chests.push(Chest { x: chest_spots[i * 2], z: chest_spots[i * 2 + 1], taken: 0 })
    }

    // ---- storm ----
    let storm_r = STORM_R0
    let storm_dmg_t = 0

    // ---- messages ----
    let msg = ""
    let msg_t = 0

    // ---- tracers ----
    let tr_x0 = 0.0
    let tr_y0 = 0.0
    let tr_z0 = 0.0
    let tr_x1 = 0.0
    let tr_y1 = 0.0
    let tr_z1 = 0.0
    let tr_life = 0

    let frame = 0
    let playing = 1
    let result = 0        // 0 = ongoing, 1 = victory, 2 = eliminated
    let place = 0

    while playing == 1 {
        // ---------- input ----------
        if key_down(87) || key_down(38) { yaw = yaw - 0.0 }        // W = forward (handled below)
        let mx = mouse_x()
        let my = mouse_y()
        // mouse look: offset from center = turn speed
        yaw = yaw + (mx - 128.0) * 0.004
        pitch = pitch - (my - 72.0) * 0.003
        if pitch > 0.9 { pitch = 0.9 }
        if pitch < -0.9 { pitch = -0.9 }

        // WASD movement (camera-relative)
        let sx = cos(yaw)
        let sz = -sin(yaw)
        let mvx = 0.0
        let mvz = 0.0
        if key_down(87) { mvx = mvx + sz; mvz = mvz + cos(yaw) }     // W: forward
        if key_down(83) { mvx = mvx - sz; mvz = mvz - cos(yaw) }     // S
        if key_down(65) { mvx = mvx - sx; mvz = mvz + sin(yaw) }    // A
        if key_down(68) { mvx = mvx + sx; mvz = mvz - sin(yaw) }    // D
        let mlen = sqrt(mvx * mvx + mvz * mvz)
        if mlen > 0.01 {
            mvx = mvx / mlen
            mvz = mvz / mlen
            let nx = px + mvx * 0.55
            let nz = pz + mvz * 0.55
            if wall_blocks(walls, nx, pz, 1.2) == 0 { px = nx }
            if wall_blocks(walls, px, nz, 1.2) == 0 { pz = nz }
        }
        // stay on the island
        if px < 8.0 { px = 8.0 }
        if px > 248.0 { px = 248.0 }
        if pz < 8.0 { pz = 8.0 }
        if pz > 248.0 { pz = 248.0 }

        // jump
        if key_down(32) {
            if grounded == 1 { vy = 5.0; grounded = 0 }
        }
        vy = vy - 0.35
        py = py + vy
        let ground = terrain_h(px, pz)
        if py <= ground { py = ground; vy = 0.0; grounded = 1 }

        // build (B): wall 8 units ahead
        if build_cd > 0 { build_cd = build_cd - 1 }
        if key_down(66) {
            if build_cd == 0 {
                let wx = px + sz * 10.0
                let wz = pz + cos(yaw) * 10.0
                wx = floor(wx / 8.0) * 8.0 + 4.0
                wz = floor(wz / 8.0) * 8.0 + 4.0
                let placed = 0
                for i in 0 .. MAX_WALLS {
                    if walls[i].hp == 0 {
                        if placed == 0 {
                            walls[i] = Wall { x: wx, z: wz, hp: 60, hit: 0 }
                            placed = 1
                        }
                    }
                }
                build_cd = 14
                msg = "WALL BUILT"
                msg_t = 40
            }
        }

        // shoot (click): hitscan from eye
        if shoot_cd > 0 { shoot_cd = shoot_cd - 1 }
        if mouse_down() {
            if shoot_cd == 0 {
                shoot_cd = 10
                let f = cam_forward(Camera { x: px, y: py + 3.6, z: pz, yaw: yaw, pitch: pitch })
                let ox = px
                let oy = py + 3.6
                let oz = pz
                let best_t = 120.0
                let hit_bot = -1
                let hit_wall = -1
                // bots
                for i in 0 .. MAX_BOTS {
                    let b = bots[i]
                    if b.alive == 1 {
                        let t = ray_sphere(ox, oy, oz, f.x, f.y, f.z, b.x, terrain_h(b.x, b.z) + 2.5, b.z, 2.2)
                        if t > 0.5 {
                            if t < best_t { best_t = t; hit_bot = i; hit_wall = -1 }
                        }
                    }
                }
                // walls
                for i in 0 .. MAX_WALLS {
                    let w = walls[i]
                    if w.hp > 0 {
                        let t = ray_aabb(ox, oy, oz, f.x, f.y, f.z, w.x - 4.0, terrain_h(w.x, w.z), w.z - 4.0, w.x + 4.0, terrain_h(w.x, w.z) + 6.0, w.z + 4.0)
                        if t > 0.5 {
                            if t < best_t { best_t = t; hit_wall = i; hit_bot = -1 }
                        }
                    }
                }
                // terrain march
                let tt = 2.0
                while tt < best_t {
                    let hx = ox + f.x * tt
                    let hy = oy + f.y * tt
                    let hz = oz + f.z * tt
                    if hy < terrain_h(hx, hz) {
                        best_t = tt
                        hit_bot = -1
                        hit_wall = -1
                        break
                    }
                    tt = tt + 2.0
                }
                // tracer
                tr_x0 = ox; tr_y0 = oy; tr_z0 = oz
                tr_x1 = ox + f.x * best_t; tr_y1 = oy + f.y * best_t; tr_z1 = oz + f.z * best_t
                tr_life = 5
                // apply damage
                if hit_bot >= 0 {
                    let b = bots[hit_bot]
                    b.hp = b.hp - 34
                    b.flash = 4
                    if b.hp <= 0 {
                        b.alive = 0
                        kills = kills + 1
                        msg = "ENEMY ELIMINATED"
                        msg_t = 60
                    } else {
                        // bots retaliate: aggro on being shot
                        b.tx = px
                        b.tz = pz
                    }
                    bots[hit_bot] = b
                }
                if hit_wall >= 0 {
                    let w = walls[hit_wall]
                    w.hp = w.hp - 34
                    w.hit = 4
                    if w.hp <= 0 { w.hp = 0 }
                    walls[hit_wall] = w
                }
            }
        }

        // ---------- bots ----------
        for i in 0 .. MAX_BOTS {
            let b = bots[i]
            if b.alive == 1 {
                b.timer = b.timer - 1
                b.flash = b.flash - 1
                if b.flash < 0 { b.flash = 0 }
                if b.cd > 0 { b.cd = b.cd - 1 }
                // new wander target near the storm center as it shrinks
                if b.timer <= 0 {
                    b.timer = 90 + rand_int(0, 90)
                    let ang = rand_int(0, 628) * 0.01
                    let rad = rand_int(10, 60) * 1.0
                    b.tx = 128.0 + cos(ang) * rad
                    b.tz = 128.0 + sin(ang) * rad
                }
                // move toward target
                let dx = b.tx - b.x
                let dz = b.tz - b.z
                let dl = sqrt(dx * dx + dz * dz)
                if dl > 2.0 {
                    let nx = b.x + dx / dl * 0.35
                    let nz = b.z + dz / dl * 0.35
                    if wall_blocks(walls, nx, b.z, 1.0) == 0 { b.x = nx }
                    if wall_blocks(walls, b.x, nz, 1.0) == 0 { b.z = nz }
                }
                // stay inside the storm
                let sdx = b.x - 128.0
                let sdz = b.z - 128.0
                let sd = sqrt(sdx * sdx + sdz * sdz)
                if sd > storm_r - 4.0 {
                    b.x = 128.0 + sdx / sd * (storm_r - 6.0)
                    b.z = 128.0 + sdz / sd * (storm_r - 6.0)
                }
                // shoot at player when close
                let pdx = px - b.x
                let pdz = pz - b.z
                let pd = sqrt(pdx * pdx + pdz * pdz)
                if pd < 55.0 {
                    if b.cd == 0 {
                        b.cd = 50 + rand_int(0, 60)
                        let acc = 0.75 - pd * 0.008
                        let roll = rand_int(0, 100) * 0.01
                        if roll < acc {
                            hp = hp - 7
                            msg = "HIT BY ENEMY -7"
                            msg_t = 40
                        }
                    }
                }
            }
            bots[i] = b
        }

        // ---------- storm ----------
        if frame > 240 { storm_r = storm_r - 0.018 }
        if storm_r < 4.0 { storm_r = 4.0 }
        storm_dmg_t = storm_dmg_t + 1
        let pdx = px - 128.0
        let pdz = pz - 128.0
        let pd = sqrt(pdx * pdx + pdz * pdz)
        let outside = 0
        if pd > storm_r { outside = 1 }
        if outside == 1 {
            if storm_dmg_t % 40 == 0 { hp = hp - 2 }
        }
        // bots take storm damage too
        if storm_dmg_t % 40 == 0 {
            for i in 0 .. MAX_BOTS {
                let b = bots[i]
                if b.alive == 1 {
                    let bx = b.x - 128.0
                    let bz = b.z - 128.0
                    let bd = sqrt(bx * bx + bz * bz)
                    if bd > storm_r {
                        b.hp = b.hp - 2
                        if b.hp <= 0 { b.alive = 0 }
                    }
                }
                bots[i] = b
            }
        }

        // ---------- chests ----------
        for i in 0 .. MAX_CHESTS {
            let c = chests[i]
            if c.taken == 0 {
                let dx = px - c.x
                let dz = pz - c.z
                if dx * dx + dz * dz < 25.0 {
                    c.taken = 1
                    hp = hp + 25
                    if hp > 100 { hp = 100 }
                    msg = "CHEST +25 HP"
                    msg_t = 60
                }
            }
            chests[i] = c
        }

        // ---------- win / lose ----------
        let alive_bots = 0
        for i in 0 .. MAX_BOTS {
            if bots[i].alive == 1 { alive_bots = alive_bots + 1 }
        }
        if hp <= 0 {
            playing = 0
            result = 2
            place = alive_bots + 1
        }
        if alive_bots == 0 {
            if hp > 0 {
                playing = 0
                result = 1
            }
        }

        // ---------- camera ----------
        let f = cam_forward(Camera { x: 0.0, y: 0.0, z: 0.0, yaw: yaw, pitch: pitch })
        let cam = Camera { x: px - f.x * 9.0, y: py + 5.0 - f.y * 4.0, z: pz - f.z * 9.0, yaw: yaw, pitch: pitch }

        // ---------- render ----------
        clear(SKY)

        // terrain: 16-unit quads, far-to-near not needed (z-buffer)
        let gx = 0
        while gx < 256 {
            let gz = 0
            while gz < 256 {
                let h00 = terrain_h(gx * 1.0, gz * 1.0)
                let h10 = terrain_h(gx + 16.0, gz * 1.0)
                let h01 = terrain_h(gx * 1.0, gz + 16.0)
                let h11 = terrain_h(gx + 16.0, gz + 16.0)
                let c = terrain_color((h00 + h10 + h01 + h11) * 0.25)
                // flat shading by slope
                let n0 = Vec3 { x: h10 - h00, y: 4.0, z: h01 - h00 }
                let n = n0.normalized()
                let l = 0.75 + (n.x * 0.3 + n.y * 0.5 + n.z * 0.3) * 0.25
                c = color_shade(c, l)
                draw_quad(cam,
                    Vec3 { x: gx * 1.0, y: h00, z: gz * 1.0 },
                    Vec3 { x: gx + 16.0, y: h10, z: gz * 1.0 },
                    Vec3 { x: gx + 16.0, y: h11, z: gz + 16.0 },
                    Vec3 { x: gx * 1.0, y: h01, z: gz + 16.0 },
                    c)
                gz = gz + 16
            }
            gx = gx + 16
        }

        // water ring beyond the island edge
        draw_quad(cam, Vec3 { x: -40.0, y: -0.6, z: -40.0 }, Vec3 { x: 296.0, y: -0.6, z: -40.0 }, Vec3 { x: 296.0, y: -0.6, z: 296.0 }, Vec3 { x: -40.0, y: -0.6, z: 296.0 }, 0x1E5FA8)

        // walls: 5 faces (skip bottom)
        for i in 0 .. MAX_WALLS {
            let w = walls[i]
            if w.hp > 0 {
                let wy = terrain_h(w.x, w.z)
                let c = 0xC8A878
                if w.hit > 0 { c = 0xFFFFFF; w.hit = w.hit - 1; walls[i] = w }
                // top
                draw_quad(cam, Vec3 { x: w.x - 4, y: wy + 6, z: w.z - 4 }, Vec3 { x: w.x + 4, y: wy + 6, z: w.z - 4 }, Vec3 { x: w.x + 4, y: wy + 6, z: w.z + 4 }, Vec3 { x: w.x - 4, y: wy + 6, z: w.z + 4 }, color_shade(c, 1.05))
                // sides
                draw_quad(cam, Vec3 { x: w.x - 4, y: wy, z: w.z - 4 }, Vec3 { x: w.x + 4, y: wy, z: w.z - 4 }, Vec3 { x: w.x + 4, y: wy + 6, z: w.z - 4 }, Vec3 { x: w.x - 4, y: wy + 6, z: w.z - 4 }, color_shade(c, 0.8))
                draw_quad(cam, Vec3 { x: w.x - 4, y: wy, z: w.z + 4 }, Vec3 { x: w.x + 4, y: wy, z: w.z + 4 }, Vec3 { x: w.x + 4, y: wy + 6, z: w.z + 4 }, Vec3 { x: w.x - 4, y: wy + 6, z: w.z + 4 }, color_shade(c, 0.6))
                draw_quad(cam, Vec3 { x: w.x - 4, y: wy, z: w.z - 4 }, Vec3 { x: w.x - 4, y: wy, z: w.z + 4 }, Vec3 { x: w.x - 4, y: wy + 6, z: w.z + 4 }, Vec3 { x: w.x - 4, y: wy + 6, z: w.z - 4 }, color_shade(c, 0.7))
                draw_quad(cam, Vec3 { x: w.x + 4, y: wy, z: w.z - 4 }, Vec3 { x: w.x + 4, y: wy, z: w.z + 4 }, Vec3 { x: w.x + 4, y: wy + 6, z: w.z + 4 }, Vec3 { x: w.x + 4, y: wy + 6, z: w.z - 4 }, color_shade(c, 0.9))
            }
        }

        // chests
        for i in 0 .. MAX_CHESTS {
            let c = chests[i]
            if c.taken == 0 {
                let gy = terrain_h(c.x, c.z)
                let r = cam_right(cam)
                draw_quad(cam,
                    Vec3 { x: c.x - r.x * 1.4, y: gy, z: c.z - r.z * 1.4 },
                    Vec3 { x: c.x + r.x * 1.4, y: gy, z: c.z + r.z * 1.4 },
                    Vec3 { x: c.x + r.x * 1.4, y: gy + 1.6, z: c.z + r.z * 1.4 },
                    Vec3 { x: c.x - r.x * 1.4, y: gy + 1.6, z: c.z - r.z * 1.4 },
                    0xE8C030)
            }
        }

        // bots
        for i in 0 .. MAX_BOTS {
            let b = bots[i]
            if b.alive == 1 { draw_bot(cam, b) }
        }

        // player
        draw_player(cam, px, pz, py)

        // storm ring: 40 projected line segments
        let prev_sx = 0.0
        let prev_sy = 0.0
        let prev_vis = 0
        let seg = 0
        while seg < 41 {
            let ang = seg * 0.15708        // 2pi/40
            let wx = 128.0 + cos(ang) * storm_r
            let wz = 128.0 + sin(ang) * storm_r
            let wy = terrain_h(wx, wz) + 1.5
            let pr = project(cam, Vec3 { x: wx, y: wy, z: wz })
            if prev_vis == 1 {
                if pr.visible == 1 {
                    draw_line(prev_sx, prev_sy, pr.sx, pr.sy, 0xB23BD6)
                }
            }
            prev_sx = pr.sx
            prev_sy = pr.sy
            prev_vis = pr.visible
            seg = seg + 1
        }

        // tracer
        if tr_life > 0 {
            let p0 = project(cam, Vec3 { x: tr_x0, y: tr_y0, z: tr_z0 })
            let p1 = project(cam, Vec3 { x: tr_x1, y: tr_y1, z: tr_z1 })
            if p0.visible == 1 {
                if p1.visible == 1 { draw_line(p0.sx, p0.sy, p1.sx, p1.sy, 0xFFF0A0) }
            }
            tr_life = tr_life - 1
        }

        // ---------- HUD ----------
        // HP bar
        draw_rect(4.0, 4.0, 52.0, 5.0, 0x202020)
        let hpw = hp * 0.5
        if hpw < 0.0 { hpw = 0.0 }
        draw_rect(5.0, 5.0, hpw, 3.0, 0x30D050)
        draw_text(4.0, 11.0, "HP ", 0xFFFFFF)
        draw_text(16.0, 11.0, to_string(hp), 0xFFFFFF)
        // alive count + kills
        let alive_bots = 0
        for i in 0 .. MAX_BOTS {
            if bots[i].alive == 1 { alive_bots = alive_bots + 1 }
        }
        draw_text(200.0, 4.0, "ALIVE ", 0xFFFFFF)
        draw_text(232.0, 4.0, to_string(alive_bots + 1), 0xFFFFFF)
        draw_text(200.0, 11.0, "ELIMS ", 0xFFFFFF)
        draw_text(232.0, 11.0, to_string(kills), 0xFFFFFF)
        // storm timer
        draw_text(96.0, 4.0, "STORM ", 0xD8A0E8)
        draw_text(128.0, 4.0, to_string(storm_r), 0xD8A0E8)
        // crosshair
        draw_line(124.0, 72.0, 132.0, 72.0, 0xFFFFFF)
        draw_line(128.0, 68.0, 128.0, 76.0, 0xFFFFFF)
        // message
        if msg_t > 0 {
            draw_text(96.0, 130.0, msg, 0xFFE060)
            msg_t = msg_t - 1
        }
        // controls hint
        draw_text(4.0, 136.0, "WASD+MOUSE AIM CLICK SHOOT B BUILD SPACE JUMP", 0xA0C8D8)

        // ---------- present ----------
        present()

        if frame % 3 == 0 { sleep_ms(16) }
        frame = frame + 1
        if frame > FRAMES { playing = 0 }
    }

    // ---------- end screen ----------
    clear(0x101418)
    if result == 1 {
        draw_text(72.0, 60.0, "VICTORY ROYALE!", 0xFFD040)
        draw_text(64.0, 72.0, "LAST ONE STANDING", 0xFFFFFF)
    }
    if result == 2 {
        draw_text(72.0, 60.0, "ELIMINATED", 0xFF5050)
        draw_text(56.0, 72.0, "PLACEMENT #", 0xFFFFFF)
        draw_text(136.0, 72.0, to_string(place), 0xFFFFFF)
    }
    if result == 0 {
        draw_text(80.0, 60.0, "GAME OVER", 0xFFFFFF)
        draw_text(48.0, 72.0, "MATCH TIMED OUT", 0xA0A0A0)
    }
    draw_text(56.0, 90.0, "ELIMS: ", 0xFFFFFF)
    draw_text(104.0, 90.0, to_string(kills), 0xFFFFFF)
    present()
    sleep_ms(600)

    print("fort island match over: result=", result, " elims=", kills, " placement=", place)
}
