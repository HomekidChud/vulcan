// SNAKE — written in pure Vulcan.
// Controls: WASD (or hjkl), q to quit.
// Terminal is switched to raw mode; `defer` restores it on any exit path.

const W: i64 = 24
const H: i64 = 16

struct Pt { x: i64, y: i64 }

fn occupied(body: [Pt], x: i64, y: i64) -> bool {
    for p in body {
        if p.x == x && p.y == y { return true }
    }
    return false
}

fn spawn_food(body: [Pt]) -> Pt {
    loop {
        let x = rand() % W
        let y = rand() % H
        if !occupied(body, x, y) {
            return Pt { x: x, y: y }
        }
    }
}

fn draw(body: [Pt], food: Pt, score: i64) -> void {
    clear_screen()
    print(f"  SNAKE — score {score} — wasd to move, q to quit")
    put("+")
    for x in 0 .. W + 2 { put("-") }
    print("+")
    for y in 0 .. H {
        put("| ")
        for x in 0 .. W {
            if occupied(body, x, y) {
                put("#")
            }
            elif x == food.x && y == food.y {
                put("*")
            }
            else {
                put(" ")
            }
        }
        print(" |")
    }
    put("+")
    for x in 0 .. W + 2 { put("-") }
    print("+")
}

fn main() -> void {
    term_raw()
    defer {
        term_normal()
    }

    // body is stored tail-first: last element is the head
    let body = [Pt { x: 3, y: 8 }, Pt { x: 4, y: 8 }, Pt { x: 5, y: 8 }]
    let dir = Pt { x: 1, y: 0 }
    let food = spawn_food(body)
    let score = 0
    let alive = true

    print("ready... eat the *")
    sleep_ms(1000)

    while alive {
        // drain all pending keys
        while key_ready() == 1 {
            let k = read_key()
            if k == 'q' {
                alive = false
            }
            elif k == 'w' { if dir.y != 1 { dir = Pt { x: 0, y: -1 } } }
            elif k == 's' { if dir.y != -1 { dir = Pt { x: 0, y: 1 } } }
            elif k == 'a' { if dir.x != 1 { dir = Pt { x: -1, y: 0 } } }
            elif k == 'd' { if dir.x != -1 { dir = Pt { x: 1, y: 0 } } }
        }
        if !alive { break }

        let head = body.last()
        let nx = head.x + dir.x
        let ny = head.y + dir.y

        // wall collision
        if nx < 0 || nx >= W || ny < 0 || ny >= H {
            alive = false
            break
        }
        // self collision
        if occupied(body, nx, ny) {
            alive = false
            break
        }

        body.push(Pt { x: nx, y: ny })
        if nx == food.x && ny == food.y {
            score++
            food = spawn_food(body)
        }
        else {
            let _ = body.shift()
        }

        draw(body, food, score)
        sleep_ms(110)
    }

    clear_screen()
    print(f"game over — final score: {score}")
}
