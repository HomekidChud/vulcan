// examples/bounce.vulcan — bouncy balls with the physics engine.
// Runs in the IDE (vulcan ide) with live graphics, or natively in your
// terminal with ANSI graphics. Press Ctrl+C to stop early when native.
import physics

fn render(w: World) -> void {
    clear(0x101828)
    let i = 0
    while i < world_body_count(w) {
        let shape = body_shape(w, i)
        if shape == PH_CIRCLE {
            let r = body_hw(w, i)
            draw_circle(body_x(w, i), body_y(w, i), r, 0x4fc3f7)
        }
        else {
            draw_rect(body_x(w, i) - body_hw(w, i), body_y(w, i) - body_hh(w, i), body_hw(w, i) * 2.0, body_hh(w, i) * 2.0, 0xffb74d)
        }
        i += 1
    }
    draw_text(4.0, 4.0, "BOUNCE - VULCAN PHYSICS", 0xffffff)
    present()
}

fn main() -> void {
    let w = world_new(0.0, 900.0)
    w = world_add_bounds(w, 0.75, 0.1)
    w = world_add_circle(w, 40.0, 30.0, 8.0, 1.0, 0.8, 0.1)
    w = world_add_circle(w, 80.0, 15.0, 6.0, 0.5, 0.8, 0.1)
    w = world_add_circle(w, 120.0, 60.0, 10.0, 2.0, 0.8, 0.1)
    w = world_add_circle(w, 160.0, 25.0, 5.0, 0.3, 0.8, 0.1)
    w = world_add_circle(w, 200.0, 45.0, 7.0, 1.0, 0.8, 0.1)
    w = world_add_circle(w, 230.0, 10.0, 4.0, 0.2, 0.8, 0.1)
    print("simulating 600 frames...")
    let f = 0
    while f < 600 {
        w = world_step(w, 1.0 / 60.0)
        render(w)
        sleep_ms(16)
        f += 1
    }
    let i = 0
    while i < world_body_count(w) {
        print("ball", i, "at", body_x(w, i), body_y(w, i))
        i += 1
    }
    print("done")
}
