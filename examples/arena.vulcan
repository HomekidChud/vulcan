// examples/arena.vulcan — VULCAN ARENA, a real game built on the engine.
//
// Wave-survival first-person shooter: bots hunt you, you fight back with
// a hitscan rifle, health packs spawn each wave, five waves to win.
// Controls: WASD move, mouse drag / touch drag to aim, F or FIRE button
// to shoot, SPACE / JUMP to jump, R restarts after game over.
// Playable in the IDE, the web bundle (desktop + phone), and natively.

import engine

// game states
const ST_PLAYING: i64 = 0
const ST_GAMEOVER: i64 = 1
const ST_VICTORY: i64 = 2

// terrain color for the arena island
fn arena_ground(h: f64, sun: f64) -> i64 {
    if h < 0.0 { return 0x1D5E8A }
    if h < 0.6 { return color_shade(0xC2A36B, sun) }
    if h < 2.2 { return color_shade(0x3E7C3A, sun) }
    return color_shade(0x6B6F73, sun)
}

// draw the heightmap with fog (same pipeline as the island demo)
fn draw_ground(s: Scene, sun: f64, fog_col: i64) -> void {
    let n = s.terrain.len()
    if n < 2 { return }
    let cell = s.terrain_scale
    let half = s.terrain_size / 2.0
    for r in 0 .. n - 1 {
        for c in 0 .. n - 1 {
            let x0 = (c as f64) * cell - half
            let z0 = (r as f64) * cell - half
            let h00 = s.terrain[r][c]
            let h10 = s.terrain[r][c + 1]
            let h11 = s.terrain[r + 1][c + 1]
            let h01 = s.terrain[r + 1][c]
            let avg = (h00 + h10 + h11 + h01) / 4.0
            let shade = 0.75 + 0.25 * ((r + c) % 2)
            let col = arena_ground(avg, sun * shade)
            let cx = x0 + cell / 2.0 - s.camera.x
            let cz = z0 + cell / 2.0 - s.camera.z
            col = fog_mix(col, sqrt(cx * cx + cz * cz), fog_col)
            draw_quad(s.camera,
                Vec3 { x: x0, y: h00, z: z0 },
                Vec3 { x: x0 + cell, y: h10, z: z0 },
                Vec3 { x: x0 + cell, y: h11, z: z0 + cell },
                Vec3 { x: x0, y: h01, z: z0 + cell },
                col)
        }
    }
}

// deactivate dead entities (never the player) + a death puff
fn cull_dead(s: Scene) -> Scene {
    let i = 0
    while i < s.entities.len() {
        let e = s.entities[i]
        if e.active && e.kind != ENTITY_KIND_PLAYER && e.hp <= 0.0 {
            s.entities[i].active = false
            s = scene_spawn_particle(s, e.pos, Vec3 { x: 0.0, y: 2.5, z: 0.0 }, 0.4, 0xEF5350)
        }
        i = i + 1
    }
    return s
}

fn main() -> void {
    // ---- state ----
    let s = scene_new()
    s = terrain_sines(s, 16, 3.0)
    s = scene_spawn(s, "player", ENTITY_KIND_PLAYER, Vec3 { x: 0.0, y: 6.0, z: 0.0 })
    let player = scene_last_id(s)
    s = scene_spawn_pickup(s, "medkit", Vec3 { x: 5.0, y: 1.5, z: 5.0 })

    let yaw = 0.0
    let pitch = -0.1
    let weapon = weapon_new("rifle", 22.0, 0.22, true, 60.0, 8, 1.4)
    let state = ST_PLAYING
    let wave = 0
    let kills = 0
    let score = 0
    let wave_msg_timer = 0.0
    let spawn_flash = 0.0
    let botm = mesh_cube(0.55, 0xEF5350)
    let medkit = mesh_cube(0.3, 0x66BB6A)

    // ---- per-frame loop ----
    while true {
        let dt = 1.0 / 60.0

        // --- look: mouse / touch drag ---
        let mdx = mouse_dx()
        let mdy = mouse_dy()
        yaw = yaw + mdx * 0.005
        pitch = pitch - mdy * 0.004
        if pitch > 0.9 { pitch = 0.9 }
        if pitch < -0.9 { pitch = -0.9 }

        // --- one-shot keys (fire, restart) ---
        if key_ready() > 0 {
            let k = read_key()
            if k == 102 {
                // f = fire
                if state == ST_PLAYING && weapon_can_fire(weapon) {
                    weapon = weapon_fire(weapon)
                    let eye = s.camera
                    let dir = cam_forward(s.camera)
                    s = scene_shoot(s, player, Vec3 { x: eye.x, y: eye.y, z: eye.z }, dir, 60.0, weapon.damage)
                    // muzzle flash
                    s = scene_spawn_particle(s,
                        Vec3 { x: eye.x + dir.x, y: eye.y + dir.y, z: eye.z + dir.z },
                        Vec3 { x: dir.x * 6.0, y: dir.y * 6.0 + 1.0, z: dir.z * 6.0 }, 0.15, 0xFFD54F)
                    spawn_flash = 0.08
                }
            }
            if k == 114 && state != ST_PLAYING {
                // r = restart
                s = scene_new()
                s = terrain_sines(s, 16, 3.0)
                s = scene_spawn(s, "player", ENTITY_KIND_PLAYER, Vec3 { x: 0.0, y: 6.0, z: 0.0 })
                player = scene_last_id(s)
                s = scene_spawn_pickup(s, "medkit", Vec3 { x: 5.0, y: 1.5, z: 5.0 })
                weapon = weapon_new("rifle", 22.0, 0.22, true, 60.0, 8, 1.4)
                state = ST_PLAYING
                wave = 0
                kills = 0
                score = 0
                wave_msg_timer = 0.0
            }
        }

        // --- playing: simulate ---
        if state == ST_PLAYING {
            // camera first, so movement is camera-relative
            let pi = scene_find(s, player)
            if pi >= 0 {
                s.camera = cam_first_person(s.entities[pi].pos, yaw, pitch)
            }
            s = player_move_cam(s, player, dt)
            s = bot_think(s, dt)
            s = engine_tick(s, dt, dt)

            // cull the dead, count the kills
            let before = scene_count_alive(s, ENTITY_KIND_BOT)
            s = cull_dead(s)
            let after = scene_count_alive(s, ENTITY_KIND_BOT)
            if after < before {
                kills = kills + (before - after)
                score = score + (before - after) * 100
            }

            // wave logic: spawn when the arena is clear
            if scene_count_alive(s, ENTITY_KIND_BOT) == 0 {
                wave = wave + 1
                if wave > 5 {
                    state = ST_VICTORY
                } else {
                    wave_msg_timer = 2.5
                    let i = 0
                    while i < wave + 1 {
                        let ang = (i as f64) * 1.2566 + (wave as f64) * 0.7
                        let px = cos(ang) * 20.0
                        let pz = sin(ang) * 20.0
                        s = scene_spawn(s, "bot", ENTITY_KIND_BOT, Vec3 { x: px, y: 8.0, z: pz })
                        let bi = scene_find(s, scene_last_id(s))
                        s.entities[bi].hp = 50.0 + (wave as f64) * 15.0
                        s.entities[bi].max_hp = 50.0 + (wave as f64) * 15.0
                        i = i + 1
                    }
                    // a medkit each wave
                    s = scene_spawn_pickup(s, "medkit", Vec3 { x: -6.0, y: 1.5, z: 4.0 })
                }
            }

            // pickups: heal on touch
            let pi2 = scene_find(s, player)
            let i = 0
            while i < s.entities.len() {
                let e = s.entities[i]
                if e.active && e.kind == ENTITY_KIND_PICKUP && pi2 >= 0 {
                    let dx = e.pos.x - s.entities[pi2].pos.x
                    let dz = e.pos.z - s.entities[pi2].pos.z
                    if dx * dx + dz * dz < 2.25 {
                        s.entities[pi2].hp = s.entities[pi2].max_hp
                        s.entities[i].active = false
                        s = scene_spawn_particle(s, e.pos, Vec3 { x: 0.0, y: 3.0, z: 0.0 }, 0.5, 0x66BB6A)
                    }
                }
                i = i + 1
            }

            // auto reload when empty
            if weapon.ammo == 0 && weapon.reloading == 0.0 {
                weapon = weapon_reload(weapon)
            }
            weapon = weapon_tick(weapon, dt)

            // player death
            if pi >= 0 {
                if s.entities[pi].hp <= 0.0 { state = ST_GAMEOVER }
            }
        }

        // --- render ---
        let sky = sky_colors(s.time)
        let sun = sun_light(s.time)
        clear(sky[0])
        draw_sky_gradient(sky[0], sky[1], 96)
        draw_ground(s, sun, sky[1])
        let i = 0
        while i < s.entities.len() {
            let e = s.entities[i]
            if !e.active { i = i + 1; continue }
            if e.kind == ENTITY_KIND_BOT {
                mesh_draw(botm, s.camera, e.pos, s.time * 2.0 + e.id as f64)
            }
            if e.kind == ENTITY_KIND_PICKUP {
                let bob = 0.3 + 0.25 * sin(s.time * 2.5 + e.id as f64)
                mesh_draw(medkit, s.camera, Vec3 { x: e.pos.x, y: e.pos.y + bob, z: e.pos.z }, 0.5)
            }
            i = i + 1
        }
        draw_particles(s)

        // --- HUD ---
        let pi = scene_find(s, player)
        if pi >= 0 {
            hud_health_bar(4, 136, 60, s.entities[pi].hp, s.entities[pi].max_hp)
        }
        hud_minimap(s, 200, 4, 52, 46.0)
        hud_crosshair(128, 72)
        hud_compass(s.camera.yaw, 84, 4, 64)
        draw_text(4, 4, "VULCAN ARENA", 0xFFFFFF)
        let wave_s = "WAVE " + to_string(wave) + " KILLS " + to_string(kills) + " SCORE " + to_string(score)
        draw_text(4, 12, wave_s, 0x9FB4C7)
        let ammo_s = "AMMO " + to_string(weapon.ammo)
        if weapon.reloading > 0.0 { ammo_s = "RELOADING" }
        draw_text(196, 136, ammo_s, 0xFFD54F)
        if wave_msg_timer > 0.0 {
            wave_msg_timer = wave_msg_timer - dt
            draw_text(104, 60, "WAVE " + to_string(wave), 0xFFD54F)
            draw_text(92, 70, "BOTS INCOMING", 0xEF5350)
        }
        if spawn_flash > 0.0 {
            spawn_flash = spawn_flash - dt
            draw_rect(120.0, 68.0, 16.0, 8.0, 0xFFD54F)
        }
        if state == ST_GAMEOVER {
            draw_rect(48.0, 56.0, 160.0, 32.0, 0x101820)
            draw_text(92, 62, "GAME OVER", 0xEF5350)
            draw_text(64, 74, "SCORE " + to_string(score) + "  PRESS R", 0x9FB4C7)
        }
        if state == ST_VICTORY {
            draw_rect(48.0, 56.0, 160.0, 32.0, 0x101820)
            draw_text(84, 62, "YOU SURVIVED", 0x66BB6A)
            draw_text(64, 74, "SCORE " + to_string(score) + "  PRESS R", 0x9FB4C7)
        }

        present()
        sleep_ms(16)
    }
}
