// examples/pong.vulcan — Pong in pure Vulcan.
// W/S moves your paddle (left), q quits. First to 3 wins.
// The AI is beatable — it tracks the ball, but not perfectly fast.

const W = 58
const H = 17
const PADDLE_H = 3
const WIN_SCORE = 3

struct Ball { x: f64, y: f64, dx: f64, dy: f64 }

fn draw_paddle(x: i64, y: i64, fg: i64) {
    set_color(fg, -1)
    for i in 0 .. PADDLE_H {
        print_at(x, y + i, "|")
    }
    set_color(-1, -1)
}

fn draw_border() {
    set_color(6, -1)
    print_at(0, 0, "+".repeat(W))
    print_at(0, H + 1, "+".repeat(W))
    set_color(-1, -1)
}

fn ai_move(ball: Ball, py: i64) -> i64 {
    // imperfect tracking: only chase when the ball comes toward the AI
    let target: i64 = 0
    if ball.dx > 0 {
        target = (ball.y as i64) - PADDLE_H / 2
    } else {
        target = (H - PADDLE_H) / 2
    }
    if target < py {
        return py - 1
    } elif target > py {
        return py + 1
    }
    return py
}

fn clamp_paddle(y: i64) -> i64 {
    if y < 1 { return 1 }
    if y > H - PADDLE_H { return H - PADDLE_H }
    return y
}

fn main() {
    term_raw()
    defer { term_normal() }
    cursor_visible(0)
    defer { cursor_visible(1) }

    let py = (H - PADDLE_H) / 2
    let ay = py
    let p_score = 0
    let a_score = 0
    let ball = Ball { x: W / 2, y: H / 2, dx: 1.0, dy: 0.6 }
    let playing = true
    let frame_ms: i64 = 70

    print("Pong! W/S to move, q to quit. First to 3 wins.")
    sleep_ms(1200)
    clear_screen()

    while playing {
        // input
        while key_ready() == 1 {
            let k = read_key()
            if k == 'q' {
                playing = false
            } elif k == 'w' {
                py = clamp_paddle(py - 1)
            } elif k == 's' {
                py = clamp_paddle(py + 1)
            }
        }
        if !playing { break }

        // ai
        ay = clamp_paddle(ai_move(ball, ay))

        // ball physics
        ball.x += ball.dx
        ball.y += ball.dy
        if ball.y < 1 || ball.y > H {
            ball.dy = -ball.dy
            ball.y = ball.y + 2 * ball.dy
        }

        // paddle collisions
        if ball.x < 3 && ball.x > 1 {
            let within = (ball.y as i64) >= py - 1 && (ball.y as i64) <= py + PADDLE_H
            if within && ball.dx < 0 {
                ball.dx = -ball.dx
                ball.dy = (ball.y - ((py as f64) + 1)) * 0.3
            }
        }
        if ball.x > W - 4 && ball.x < W - 2 {
            let within = (ball.y as i64) >= ay - 1 && (ball.y as i64) <= ay + PADDLE_H
            if within && ball.dx > 0 {
                ball.dx = -ball.dx
                ball.dy = (ball.y - ((ay as f64) + 1)) * 0.3
            }
        }

        // scoring
        if ball.x < 0 {
            a_score += 1
            ball = Ball { x: W / 2, y: rand_int(2, H - 2), dx: -1.0, dy: 0.5 }
        }
        if ball.x > W {
            p_score += 1
            ball = Ball { x: W / 2, y: rand_int(2, H - 2), dx: 1.0, dy: -0.5 }
        }

        // draw
        draw_border()
        draw_paddle(2, py, 2)
        draw_paddle(W - 3, ay, 4)
        set_color(7, -1)
        print_at((ball.x as i64), (ball.y as i64), "O")
        set_color(-1, -1)
        print_at(W / 2 - 4, H + 2, f"you {p_score}  ai {a_score}")

        if p_score >= WIN_SCORE || a_score >= WIN_SCORE {
            playing = false
        }
        sleep_ms(frame_ms)
    }

    cursor_visible(1)
    term_normal()
    clear_screen()
    if p_score >= WIN_SCORE {
        print(f"you win {p_score}-{a_score}!")
    } elif a_score >= WIN_SCORE {
        print(f"the ai wins {a_score}-{p_score} — rematch?")
    } else {
        print("bye!")
    }
}
