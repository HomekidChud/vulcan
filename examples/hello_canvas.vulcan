// examples/hello_canvas.vulcan — the graphics layer in 20 lines:
// a 256x144 canvas with rects, circles, lines, text and animation.
fn main() -> void {
    print("canvas:", canvas_width(), "x", canvas_height())
    let t = 0
    while t < 360 {
        clear(0x141a24)
        draw_rect(20.0, 20.0, 60.0 + 40.0 * sin(t * 0.05), 30.0, 0x4fc3f7)
        draw_circle(180.0 + 50.0 * sin(t * 0.03), 72.0, 18.0, 0xffb74d)
        draw_line(0.0, 130.0 + 10.0 * cos(t * 0.04), 255.0, 130.0 + 10.0 * sin(t * 0.04), 0x90caf9)
        draw_text(6.0, 6.0, "HELLO VULCAN", 0xffffff)
        draw_text(6.0, 134.0, t, 0x80cbc4)
        present()
        sleep_ms(16)
        t += 1
    }
    print("done")
}
