// examples/pyramid.vulcan — box stacking: a stable pyramid of crates.
// Runs in the IDE with live graphics or natively in your terminal.
import physics

fn render(w: World) -> void {
    clear(0x1a237e)
    let i = 0
    while i < world_body_count(w) {
        if body_shape(w, i) == PH_BOX {
            draw_rect(body_x(w, i) - body_hw(w, i), body_y(w, i) - body_hh(w, i), body_hw(w, i) * 2.0, body_hh(w, i) * 2.0, 0xffcc80)
        }
        i += 1
    }
    draw_text(4.0, 4.0, "PYRAMID STACK", 0xffffff)
    present()
}

fn main() -> void {
    let w = world_new(0.0, 900.0)
    w = world_add_bounds(w, 0.1, 0.8)
    // 5 floors of crates, narrowing towards the top
    let floor = 0
    while floor < 5 {
        let n = 5 - floor
        let i = 0
        while i < n {
            let x = 128.0 + (i - (n - 1) * 0.5) * 22.0
            let y = 136.0 - floor * 13.0
            w = world_add_box(w, x, y, 10.0, 6.0, 2.0, 0.05, 0.6)
            i += 1
        }
        floor += 1
    }
    // a ball on top
    w = world_add_circle(w, 128.0, 40.0, 7.0, 1.5, 0.4, 0.3)
    print("simulating 900 frames...")
    let f = 0
    while f < 900 {
        w = world_step(w, 1.0 / 60.0)
        render(w)
        sleep_ms(16)
        f += 1
    }
    print("crates settled:")
    let i = 0
    while i < world_body_count(w) {
        print("body", i, "at", body_x(w, i), body_y(w, i))
        i += 1
    }
    print("done")
}
