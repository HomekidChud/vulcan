// examples/engine_demo.vulcan — Vulcan Engine v0.4 showcase.
//
// A procedurally generated island with a full day/night cycle, distance
// fog, animated water, wandering bots that chase and shoot the player,
// mesh landmarks, pickups, particles, and a HUD. Runs in the IDE
// (`vulcan ide`) or as a web bundle (`vulcan package --platform web`).
//
// Controls: W/A/S/D move, SPACE jump, C cycles the camera
// (cinematic orbit -> third-person -> first-person mouse-look).
// In the browser bundle, click the canvas first for pointer lock.

import engine

// Terrain color by height: water, sand, grass, rock, snow.
// `sun` is the global day/night light factor (0.22 night .. 1 noon).
fn terrain_color(h: f64, sun: f64) -> i64 {
    if h < 0.0 { return 0x1B4F72 }
    if h < 0.6 { return color_shade(0xC2A36B, sun) }
    if h < 2.2 { return color_shade(0x3E7C3A, sun) }
    if h < 3.4 { return color_shade(0x6B6F73, sun) }
    return color_shade(0xECEFF1, sun)
}

// Draw the heightmap as shaded quads (one per grid cell), with distance
// fog blending toward the sky and animated sea color below the waterline.
fn draw_terrain(s: Scene, sun: f64, fog_col: i64) -> void {
    let n = s.terrain.len()
    if n < 2 { return }
    let cell = s.terrain_scale
    let half = s.terrain_size / 2.0
    for r in 0 .. n - 1 {
        for c in 0 .. n - 1 {
            let x0 = (c as f64) * cell - half
            let z0 = (r as f64) * cell - half
            let h00 = s.terrain[r][c]
            let h10 = s.terrain[r][c + 1]
            let h11 = s.terrain[r + 1][c + 1]
            let h01 = s.terrain[r + 1][c]
            let avg = (h00 + h10 + h11 + h01) / 4.0
            let shade = 0.75 + 0.25 * ((r + c) % 2)
            let col = terrain_color(avg, sun * shade)
            if avg < 0.0 {
                col = sea_color(s.time, fog_col)
            }
            // distance fog from the camera to the cell center
            let cx = x0 + cell / 2.0 - s.camera.x
            let cz = z0 + cell / 2.0 - s.camera.z
            let dist = sqrt(cx * cx + cz * cz)
            col = fog_mix(col, dist, fog_col)
            draw_quad(s.camera,
                Vec3 { x: x0, y: h00, z: z0 },
                Vec3 { x: x0 + cell, y: h10, z: z0 },
                Vec3 { x: x0 + cell, y: h11, z: z0 + cell },
                Vec3 { x: x0, y: h01, z: z0 + cell },
                col)
        }
    }
}

// Draw an entity as a small colored cube mesh.
fn draw_entity(s: Scene, i: i64, m: Mesh) -> void {
    let e = s.entities[i]
    if !e.active { return }
    mesh_draw(m, s.camera, e.pos, 0.0)
}

fn main() -> void {
    let s = scene_new()
    s = terrain_sines(s, 20, 5.0)

    s = scene_spawn(s, "player", ENTITY_KIND_PLAYER, Vec3 { x: 0.0, y: 8.0, z: 0.0 })
    let player = scene_last_id(s)
    s = scene_spawn(s, "bot1", ENTITY_KIND_BOT, Vec3 { x: 14.0, y: 8.0, z: 10.0 })
    s = scene_spawn(s, "bot2", ENTITY_KIND_BOT, Vec3 { x: -16.0, y: 8.0, z: 8.0 })
    s = scene_spawn(s, "bot3", ENTITY_KIND_BOT, Vec3 { x: 6.0, y: 8.0, z: -18.0 })

    // pickups: health packs scattered around the island
    s = scene_spawn_pickup(s, "medkit1", Vec3 { x: 6.0, y: 2.0, z: 6.0 })
    s = scene_spawn_pickup(s, "medkit2", Vec3 { x: -8.0, y: 2.0, z: -6.0 })
    s = scene_spawn_pickup(s, "medkit3", Vec3 { x: 12.0, y: 2.0, z: -12.0 })

    // shared meshes
    let body = mesh_cube(0.6, 0x4FC3F7)     // player
    let botm = mesh_cube(0.6, 0xEF5350)     // bots
    let tower = mesh_cube(1.6, 0x8E6E95)    // landmark
    let hutt = mesh_cube(1.0, 0xA1887F)     // small hut
    let medkit = mesh_cube(0.35, 0xFFD700)  // pickups

    // camera state: 0 cinematic orbit, 1 third-person, 2 first-person
    let cam_mode = 0
    let cam_yaw = 0.0
    let cam_pitch = -0.2
    let frame = 0
    while true {
        // simulate
        s = player_control(s, player, 1.0 / 60.0)
        s = bot_think(s, 1.0 / 60.0)
        s = engine_tick(s, 1.0 / 60.0, 1.0 / 60.0)

        // ---- camera ----
        let pi = scene_find(s, player)
        let ppos = Vec3 { x: 0.0, y: 0.0, z: 0.0 }
        if pi >= 0 { ppos = s.entities[pi].pos }
        // mouse look (deltas; 0 on terminals without a mouse)
        let mdx = mouse_dx()
        let mdy = mouse_dy()
        cam_yaw = cam_yaw + mdx * 0.004
        cam_pitch = cam_pitch - mdy * 0.003
        if cam_pitch > 0.9 { cam_pitch = 0.9 }
        if cam_pitch < -0.9 { cam_pitch = -0.9 }
        // 'c' (99) cycles the camera mode
        if key_ready() > 0 {
            let k = read_key()
            if k == 99 { cam_mode = cam_mode + 1 }
            if cam_mode > 2 { cam_mode = 0 }
        }
        if cam_mode == 0 {
            s.camera = cam_orbit(Vec3 { x: 0.0, y: 2.0, z: 0.0 }, (frame as f64) * 0.008, 34.0, 16.0)
        }
        if cam_mode == 1 {
            s.camera = cam_third_person(ppos, cam_yaw, 7.0, 0.25)
        }
        if cam_mode == 2 {
            s.camera = cam_first_person(ppos, cam_yaw, cam_pitch)
        }

        // particle fountain at the island peak every ~0.5s
        if frame % 30 == 0 {
            let px = 4.0
            let pz = 2.0
            let py = terrain_height(s, px, pz) + 0.5
            s = scene_spawn_particle(s, Vec3 { x: px, y: py, z: pz },
                Vec3 { x: 0.6, y: 2.4, z: 0.3 }, 1.2, 0xFFD54F)
            s = scene_spawn_particle(s, Vec3 { x: px, y: py, z: pz },
                Vec3 { x: -0.5, y: 2.0, z: -0.4 }, 1.0, 0xFF7043)
        }

        // ---- render: sky, sun light, fog ----
        let sky = sky_colors(s.time)
        let sun = sun_light(s.time)
        // clear() also resets the depth buffer — required every frame
        clear(sky[0])
        draw_sky_gradient(sky[0], sky[1], 110)
        draw_terrain(s, sun, sky[1])
        mesh_draw(tower, s.camera,
            Vec3 { x: 8.0, y: terrain_height(s, 8.0, 8.0) + 1.6, z: 8.0 },
            (frame as f64) * 0.01)
        mesh_draw(hutt, s.camera,
            Vec3 { x: -10.0, y: terrain_height(s, -10.0, 4.0) + 1.0, z: 4.0 }, 0.4)
        draw_entity(s, scene_find(s, player), body)
        let b1 = scene_find(s, 2)
        if b1 >= 0 { draw_entity(s, b1, botm) }
        let b2 = scene_find(s, 3)
        if b2 >= 0 { draw_entity(s, b2, botm) }
        let b3 = scene_find(s, 4)
        if b3 >= 0 { draw_entity(s, b3, botm) }
        // pickups (bobbing)
        let i = 0
        while i < s.entities.len() {
            let e = s.entities[i]
            if e.active && e.kind == ENTITY_KIND_PICKUP {
                let bob = 0.3 + 0.3 * sin(s.time * 2.0 + e.id as f64)
                mesh_draw(medkit, s.camera, Vec3 { x: e.pos.x, y: e.pos.y + bob, z: e.pos.z }, 0.5)
            }
            i = i + 1
        }
        draw_particles(s)

        // HUD
        if pi >= 0 {
            hud_health_bar(4, 136, 60, s.entities[pi].hp, s.entities[pi].max_hp)
        }
        hud_minimap(s, 200, 4, 52, 44.0)
        hud_crosshair(128, 72)
        hud_compass(s.camera.yaw, 96, 4, 56)
        draw_text(4, 4, "VULCAN ENGINE v0.4", 0xFFFFFF)
        draw_text(4, 12, "island demo - C: camera", 0x9FB4C7)

        present()
        sleep_ms(16)
        frame = frame + 1
    }
}
