// examples/spin_cube.vulcan — a spinning 3D cube on the canvas.
// Shows the software 3D renderer: Vec3 math, camera projection, and
// depth-buffered triangles via draw_tri. Run in the IDE for live colors.
import render3d

fn main() -> void {
    let cam = Camera { x: 0.0, y: 0.0, z: -6.0, yaw: 0.0, pitch: 0.0 }
    let t = 0.0
    while t < 6.28 {
        clear(0x101820)
        // cube corners rotated around Y by angle t
        let c = cos(t)
        let s = sin(t)
        // 8 corners: (±1, ±1, ±1) rotated
        let x0 = c - s
        let z0 = -s - c
        let x1 = c + s
        let z1 = s - c
        // front face (z = +1 rotated)
        draw_quad(cam, Vec3 { x: x0, y: -1.0, z: z0 }, Vec3 { x: x1, y: -1.0, z: z1 }, Vec3 { x: x1, y: 1.0, z: z1 }, Vec3 { x: x0, y: 1.0, z: z0 }, 0xFF8800)
        // back face (z = -1 rotated)
        draw_quad(cam, Vec3 { x: -x0, y: -1.0, z: -z0 }, Vec3 { x: -x1, y: -1.0, z: -z1 }, Vec3 { x: -x1, y: 1.0, z: -z1 }, Vec3 { x: -x0, y: 1.0, z: -z0 }, 0x3366FF)
        // right face (x = +1 rotated)
        draw_quad(cam, Vec3 { x: x1, y: -1.0, z: z1 }, Vec3 { x: -x1, y: -1.0, z: -z1 }, Vec3 { x: -x1, y: 1.0, z: -z1 }, Vec3 { x: x1, y: 1.0, z: z1 }, 0x33CC66)
        present()
        t = t + 0.05
        sleep_ms(16)
    }
    let pr = project(cam, Vec3 { x: 0.0, y: 0.0, z: 0.0 })
    print("center sx=", pr.sx, " sy=", pr.sy, " depth=", pr.depth)
    print("shade=", color_shade(0x8040C0, 0.5), " lerp=", color_lerp(0x000000, 0xFFFFFF, 0.5))
}
